{
  "$schema": "../_schema/marketRules.schema.json",
  "kind": "marketRules",
  "source": "claude",
  "notes": "Local demand (design §4; geographic supply, designer decision). A settlement sums the demand of every rule whose conditions all hold (−3..3). Supply comes from the producers (producers.json), not from these rules. A price is base × 1.25^(demand − supply), with demand − supply kept within ±3 (about ½× to 2× the base price), before drift (±10%) and bulk pressure. Each rule's label is shown when the market explains a price, so rules are few, big and legible. Water is free and never traded.",
  "entries": [
    {
      "id": "coastal-shipwrights",
      "label": "Shipwrights",
      "when": {
        "coastal": true
      },
      "demand": {
        "timber": 1
      },
      "notes": "Boats always need wood."
    },
    {
      "id": "desert-crossings",
      "label": "Desert crossings",
      "when": {
        "biomes": ["desert"]
      },
      "demand": {
        "gear": 1
      },
      "notes": "Waterskins, tents and pack frames for the caravans."
    },
    {
      "id": "jungle-fevers",
      "label": "Fevers and rust",
      "when": {
        "biomes": ["jungle"]
      },
      "demand": {
        "gear": 1,
        "healing": 1
      }
    },
    {
      "id": "garrison",
      "label": "Garrison",
      "when": {
        "types": ["fort", "stationed-garrison", "large-encampment", "encamped-army"]
      },
      "demand": {
        "arms": 2,
        "armour": 2,
        "food": 1
      },
      "notes": "Soldiers to arm and feed."
    },
    {
      "id": "capital-court",
      "label": "Court and collectors",
      "when": {
        "types": ["capital"]
      },
      "demand": {
        "luxuries": 1,
        "gems": 1,
        "relics": 1
      }
    },
    {
      "id": "city-building",
      "label": "Builders and workshops",
      "when": {
        "types": ["city", "capital"]
      },
      "demand": {
        "timber": 1,
        "stone": 1,
        "metal": 1,
        "fuel": 1
      },
      "notes": "Workshops turn raw materials into finished goods, and the city keeps growing."
    },
    {
      "id": "town-smithies",
      "label": "Smithies",
      "when": {
        "types": ["town"]
      },
      "demand": {
        "metal": 1
      }
    },
    {
      "id": "village-tools",
      "label": "Worn tools",
      "when": {
        "types": ["village", "hamlet"]
      },
      "demand": {
        "gear": 1
      }
    },
    {
      "id": "remote-outposts",
      "label": "Few pedlars",
      "when": {
        "maxSize": 1
      },
      "demand": {
        "healing": 1,
        "gear": 1,
        "alchemicals": 1
      },
      "notes": "Few pedlars come this far."
    },
    {
