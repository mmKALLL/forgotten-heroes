{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "const": "services"
    },
    "source": {
      "type": "string",
      "enum": [
        "original",
        "imported",
        "imported-private",
        "procedural",
        "claude"
      ]
    },
    "notes": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string"
          },
          "presenceThresholdBySize": {
            "minItems": 6,
            "maxItems": 6,
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema0"
            },
            "description": "Per settlement size tier (smallest first): the service exists if 1d20 + the settlement wealth bonus exceeds this value (then a further 90% chance). Values above 20 need a wealth bonus, e.g. a prosperous wizard hamlet with a university. From the prototype; needs tuning."
          },
          "itemSaleTags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "typicalRarity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "maxRarity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "id",
          "name",
          "presenceThresholdBySize",
          "itemSaleTags",
          "typicalRarity",
          "maxRarity"
        ]
      }
    }
  },
  "required": [
    "kind",
    "source",
    "entries"
  ],
  "$defs": {
    "__schema0": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
