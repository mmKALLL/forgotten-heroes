{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "const": "archetypes"
    },
    "source": {
      "type": "string",
      "enum": [
        "original",
        "imported",
        "imported-private",
        "procedural",
        "claude"
      ]
    },
    "notes": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/__schema0"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "options": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema1"
            }
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "options"
        ]
      }
    }
  },
  "required": [
    "kind",
    "source",
    "entries"
  ],
  "$defs": {
    "__schema0": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "__schema1": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/__schema2"
            },
            "label": {
              "$ref": "#/$defs/__schema3"
            },
            "description": {
              "$ref": "#/$defs/__schema4"
            },
            "requires": {
              "$ref": "#/$defs/__schema5"
            },
            "once": {
              "$ref": "#/$defs/__schema9"
            },
            "kind": {
              "type": "string",
              "const": "check"
            },
            "check": {
              "type": "object",
              "properties": {
                "skill": {
                  "$ref": "#/$defs/__schema7"
                },
                "ability": {
                  "description": "Overrides the skill's default ability, e.g. \"cha\" for Intimidation (CHA)",
                  "$ref": "#/$defs/__schema11"
                },
                "dc": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/__schema12"
                    },
                    {
                      "$ref": "#/$defs/__schema13"
                    }
                  ],
                  "description": "A DC from 1 to 40, or inside an archetype \"dc\", \"dc+2\" or \"dc-1\""
                },
                "combat": {
                  "description": "Combat checks never grant Inspiration on a natural 20",
                  "$ref": "#/$defs/__schema14"
                }
              },
              "required": [
                "skill",
                "dc"
              ]
            },
            "highStakes": {
              "description": "Force the slow, glowing dice roll",
              "$ref": "#/$defs/__schema15"
            },
            "outcomes": {
              "type": "object",
              "properties": {
                "critFail": {
                  "description": "Defaults to the fail outcome",
                  "$ref": "#/$defs/__schema16"
                },
                "fail": {
                  "$ref": "#/$defs/__schema16"
                },
                "partial": {
                  "$ref": "#/$defs/__schema16"
                },
                "success": {
                  "$ref": "#/$defs/__schema16"
                },
                "critSuccess": {
                  "description": "Defaults to the success outcome",
                  "$ref": "#/$defs/__schema16"
                }
              },
              "required": [
                "fail",
                "partial",
                "success"
              ]
            }
          },
          "required": [
            "id",
            "label",
            "kind",
            "check",
            "outcomes"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/__schema2"
            },
            "label": {
              "$ref": "#/$defs/__schema3"
            },
            "description": {
              "$ref": "#/$defs/__schema4"
            },
            "requires": {
              "$ref": "#/$defs/__schema5"
            },
            "once": {
              "$ref": "#/$defs/__schema9"
            },
            "kind": {
              "type": "string",
              "const": "fixed"
            },
            "outcome": {
              "$ref": "#/$defs/__schema16"
            }
          },
          "required": [
            "id",
            "label",
            "kind",
            "outcome"
          ]
        }
      ]
    },
    "__schema2": {
      "description": "Unique within its stage",
      "$ref": "#/$defs/__schema0"
    },
    "__schema3": {
      "type": "string"
    },
    "__schema4": {
      "type": "string"
    },
    "__schema5": {
      "default": [],
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "req": {
                "type": "string",
                "const": "gold"
              },
              "min": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "req",
              "min"
            ]
          },
          {
            "type": "object",
            "properties": {
              "req": {
                "$ref": "#/$defs/__schema6"
              },
              "skill": {
                "$ref": "#/$defs/__schema7"
              }
            },
            "required": [
              "req",
              "skill"
            ],
            "description": "Some member is not yet proficient in the skill (e.g. paying to train)"
          },
          {
            "type": "object",
            "properties": {
              "req": {
                "$ref": "#/$defs/__schema8"
              }
            },
            "required": [
              "req"
            ],
            "description": "A site's boon (a blessing, healing, a find): only in site situations. Unavailable while the site's boon is spent; choosing the option spends it for BOON_COOLDOWN_DAYS days"
          }
        ]
      }
    },
    "__schema6": {
      "type": "string",
      "const": "untrained"
    },
    "__schema7": {
      "type": "string",
      "enum": [
        "acrobatics",
        "animalHandling",
        "arcana",
        "athletics",
        "deception",
        "history",
        "insight",
        "intimidation",
        "investigation",
        "medicine",
        "nature",
        "perception",
        "performance",
        "persuasion",
        "religion",
        "sleightOfHand",
        "stealth",
        "survival"
      ]
    },
    "__schema8": {
      "type": "string",
      "const": "siteReady"
    },
    "__schema9": {
      "description": "Can only be chosen once per encounter",
      "$ref": "#/$defs/__schema10"
    },
    "__schema10": {
      "type": "boolean"
    },
    "__schema11": {
      "type": "string",
      "enum": [
        "str",
        "dex",
        "con",
        "int",
        "wis",
        "cha"
      ]
    },
    "__schema12": {
      "type": "integer",
      "minimum": 1,
      "maximum": 40
    },
    "__schema13": {
      "type": "string",
      "pattern": "^dc([+-][0-9]+)?$"
    },
    "__schema14": {
      "type": "boolean"
    },
    "__schema15": {
      "type": "boolean"
    },
    "__schema16": {
      "type": "object",
      "properties": {
        "text": {
          "$ref": "#/$defs/__schema17"
        },
        "effects": {
          "$ref": "#/$defs/__schema18"
        },
        "goto": {
          "$ref": "#/$defs/__schema53"
        },
        "stay": {
          "$ref": "#/$defs/__schema55"
        },
        "twist": {
          "description": "Replaces this outcome when the hidden twist is true",
          "$ref": "#/$defs/__schema57"
        }
      },
      "required": [
        "text"
      ]
    },
    "__schema17": {
      "type": "string"
    },
    "__schema18": {
      "default": [],
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "effect": {
                "$ref": "#/$defs/__schema19"
              },
              "amount": {
                "$ref": "#/$defs/__schema20"
              },
              "if": {
                "$ref": "#/$defs/__schema21"
              }
            },
            "required": [
              "effect",
              "amount"
            ],
            "description": "Gain or lose gold; gold never drops below 0"
          },
          {
            "type": "object",
            "properties": {
              "effect": {
                "$ref": "#/$defs/__schema26"
              },
              "amount": {
                "$ref": "#/$defs/__schema20"
              },
              "target": {
                "$ref": "#/$defs/__schema27"
              },
              "if": {
                "$ref": "#/$defs/__schema21"
              }
            },
            "required": [
              "effect",
              "amount",
              "target"
            ],
            "description": "Heal (+) or hurt (−) the acting member, everyone, or one random member who can still act"
          },
          {
            "type": "object",
            "properties": {
              "effect": {
                "$ref": "#/$defs/__schema28"
              },
              "amount": {
                "$ref": "#/$defs/__schema20"
              },
              "target": {
                "$ref": "#/$defs/__schema29"
              },
              "if": {
                "$ref": "#/$defs/__schema21"
              }
            },
            "required": [
              "effect",
              "amount",
              "target"
            ],
            "description": "Add (+) or remove (−) exhaustion levels"
          },
          {
            "type": "object",
            "properties": {
              "effect": {
                "$ref": "#/$defs/__schema30"
              },
              "amount": {
                "$ref": "#/$defs/__schema20"
              },
              "if": {
                "$ref": "#/$defs/__schema21"
              }
            },
            "required": [
              "effect",
              "amount"
            ],
            "description": "Gain (+) or lose (−) Inspiration; it never drops below 0"
          },
          {
            "type": "object",
            "properties": {
              "effect": {
                "$ref": "#/$defs/__schema31"
              },
              "amount": {
                "$ref": "#/$defs/__schema32"
              },
              "if": {
                "$ref": "#/$defs/__schema21"
              }
            },
            "required": [
              "effect",
              "amount"
            ],
            "description": "Time passes"
          },
          {
            "type": "object",
            "properties": {
              "effect": {
                "$ref": "#/$defs/__schema33"
              },
              "position": {
                "$ref": "#/$defs/__schema34"
              },
              "if": {
                "$ref": "#/$defs/__schema21"
              }
            },
            "required": [
              "effect",
              "position"
            ],
            "description": "Edge or Exposed for the next check in this encounter"
          },
          {
            "type": "object",
            "properties": {
              "effect": {
                "$ref": "#/$defs/__schema35"
              },
              "situation": {
                "$ref": "#/$defs/__schema0"
              },
              "after": {
                "$ref": "#/$defs/__schema36"
              },
              "if": {
                "$ref": "#/$defs/__schema21"
              }
            },
            "required": [
              "effect",
              "situation"
            ],
            "description": "Queue a later encounter"
          },
          {
            "type": "object",
            "properties": {
              "effect": {
                "$ref": "#/$defs/__schema38"
              },
              "amount": {
                "$ref": "#/$defs/__schema20"
              },
              "reason": {
                "$ref": "#/$defs/__schema39"
              },
              "if": {
                "$ref": "#/$defs/__schema21"
              }
            },
            "required": [
              "effect",
              "amount"
            ],
            "description": "Add to the party's next check in this encounter (e.g. −2 after misreading a situation)"
          },
          {
            "type": "object",
            "properties": {
              "effect": {
                "$ref": "#/$defs/__schema41"
              },
              "kind": {
                "$ref": "#/$defs/__schema42"
              },
              "if": {
                "$ref": "#/$defs/__schema21"
              }
            },
            "required": [
              "effect"
            ],
            "description": "Show the odds of the hidden twist"
          },
          {
            "type": "object",
            "properties": {
              "effect": {
                "$ref": "#/$defs/__schema44"
              },
              "if": {
                "$ref": "#/$defs/__schema21"
              }
            },
            "required": [
              "effect"
            ],
            "description": "The twist's opening hit: the drawn twist kind's opening effects, or a bespoke twist's `opening`. Only in twist branches."
          },
          {
            "type": "object",
            "properties": {
              "effect": {
                "type": "string",
                "const": "log"
              },
              "text": {
                "type": "string"
              },
              "tone": {
                "default": "info",
                "type": "string",
                "enum": [
                  "info",
                  "good",
                  "bad",
                  "crit"
                ]
              },
              "if": {
                "$ref": "#/$defs/__schema21"
              }
            },
            "required": [
              "effect",
              "text"
            ]
          },
          {
            "type": "object",
            "properties": {
              "effect": {
                "$ref": "#/$defs/__schema45"
              },
              "count": {
                "$ref": "#/$defs/__schema46"
              },
              "scope": {
                "$ref": "#/$defs/__schema47"
              },
              "category": {
                "$ref": "#/$defs/__schema49"
              },
              "if": {
                "$ref": "#/$defs/__schema21"
              }
            },
            "required": [
              "effect"
            ],
            "description": "Reveal the nearest undiscovered points of interest to the encounter's domain (a clue)"
          },
          {
            "type": "object",
            "properties": {
              "effect": {
                "$ref": "#/$defs/__schema51"
              },
              "if": {
                "$ref": "#/$defs/__schema21"
              }
            },
            "required": [
              "effect"
            ],
            "description": "Clear the dungeon or lair being visited: it lies empty (and feeds no threat) until something moves in again (REINHABIT_DAYS)"
          },
          {
            "type": "object",
            "properties": {
              "effect": {
                "$ref": "#/$defs/__schema52"
              },
              "skill": {
                "$ref": "#/$defs/__schema7"
              },
              "if": {
                "$ref": "#/$defs/__schema21"
              }
            },
            "required": [
              "effect",
              "skill"
            ],
            "description": "Make the best-suited member who lacks the skill proficient in it (ties: party order)"
          }
        ]
      }
    },
    "__schema19": {
      "type": "string",
      "const": "gold"
    },
    "__schema20": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "__schema21": {
      "description": "Only applies when this holds",
      "$ref": "#/$defs/__schema22"
    },
    "__schema22": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "cond": {
              "$ref": "#/$defs/__schema23"
            },
            "not": {
              "$ref": "#/$defs/__schema24"
            }
          },
          "required": [
            "cond"
          ],
          "description": "The twist's odds have been revealed earlier in the encounter (e.g. by Insight)"
        }
      ]
    },
    "__schema23": {
      "type": "string",
      "const": "twistRevealed"
    },
    "__schema24": {
      "description": "True: only when the odds are still hidden",
      "$ref": "#/$defs/__schema25"
    },
    "__schema25": {
      "type": "boolean"
    },
    "__schema26": {
      "type": "string",
      "const": "hp"
    },
    "__schema27": {
      "type": "string",
      "enum": [
        "actor",
        "all",
        "random"
      ]
    },
    "__schema28": {
      "type": "string",
      "const": "exhaustion"
    },
    "__schema29": {
      "type": "string",
      "enum": [
        "actor",
        "all"
      ]
    },
    "__schema30": {
      "type": "string",
      "const": "inspiration"
    },
    "__schema31": {
      "type": "string",
      "const": "days"
    },
    "__schema32": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "__schema33": {
      "type": "string",
      "const": "position"
    },
    "__schema34": {
      "type": "string",
      "enum": [
        "normal",
        "edge",
        "exposed"
      ]
    },
    "__schema35": {
      "type": "string",
      "const": "followUp"
    },
    "__schema36": {
      "default": 0,
      "description": "Other encounters that happen first",
      "$ref": "#/$defs/__schema37"
    },
    "__schema37": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema38": {
      "type": "string",
      "const": "nextCheckModifier"
    },
    "__schema39": {
      "description": "Shown next to the modifier, e.g. \"misread\"",
      "$ref": "#/$defs/__schema40"
    },
    "__schema40": {
      "type": "string"
    },
    "__schema41": {
      "type": "string",
      "const": "revealTwist"
    },
    "__schema42": {
      "description": "Also reveal which kind of twist it would be (twist-table twists)",
      "$ref": "#/$defs/__schema43"
    },
    "__schema43": {
      "type": "boolean"
    },
    "__schema44": {
      "type": "string",
      "const": "openingHit"
    },
    "__schema45": {
      "type": "string",
      "const": "discoverPoi"
    },
    "__schema46": {
      "default": 1,
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "__schema47": {
      "default": "domain",
      "description": "Where to look: the encounter's domain, or every domain of its land",
      "$ref": "#/$defs/__schema48"
    },
    "__schema48": {
      "type": "string",
      "enum": [
        "domain",
        "land"
      ]
    },
    "__schema49": {
      "description": "Only sites of this category",
      "$ref": "#/$defs/__schema50"
    },
    "__schema50": {
      "type": "string",
      "enum": [
        "dungeon",
        "expert",
        "lair",
        "shrine",
        "landmark",
        "wonder",
        "quest"
      ]
    },
    "__schema51": {
      "type": "string",
      "const": "clearPoi"
    },
    "__schema52": {
      "type": "string",
      "const": "trainSkill"
    },
    "__schema53": {
      "description": "Next stage. \"@twist\" (only in twist branches) goes to the twist's escalation stage. Without goto or stay, the encounter ends.",
      "$ref": "#/$defs/__schema54"
    },
    "__schema54": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema0"
        },
        {
          "type": "string",
          "const": "@twist"
        }
      ]
    },
    "__schema55": {
      "description": "Stay on the current stage",
      "$ref": "#/$defs/__schema56"
    },
    "__schema56": {
      "type": "boolean"
    },
    "__schema57": {
      "type": "object",
      "properties": {
        "text": {
          "$ref": "#/$defs/__schema17"
        },
        "effects": {
          "$ref": "#/$defs/__schema18"
        },
        "goto": {
          "$ref": "#/$defs/__schema53"
        },
        "stay": {
          "$ref": "#/$defs/__schema55"
        }
      },
      "required": [
        "text"
      ]
    }
  }
}
