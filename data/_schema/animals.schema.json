{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "const": "animals"
    },
    "source": {
      "type": "string",
      "enum": [
        "original",
        "imported",
        "imported-private",
        "procedural",
        "claude"
      ]
    },
    "notes": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/__schema0"
          },
          "name": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "minimum": 0,
            "description": "gp to buy one; owning it costs nothing more (no upkeep, designer call 2026-11-13)"
          },
          "hirePerDay": {
            "description": "gp per day to hire one for a journey to a settlement; omit if it is not for hire",
            "$ref": "#/$defs/__schema1"
          },
          "capacity": {
            "type": "number",
            "minimum": 0,
            "description": "kg it carries (or hauls)"
          },
          "speed": {
            "default": 1,
            "description": "Land speed multiplier while ridden: 2 for riding animals (less in rough terrain)",
            "$ref": "#/$defs/__schema2"
          },
          "rider": {
            "default": false,
            "description": "Carries a rider: one per member to ride",
            "$ref": "#/$defs/__schema3"
          },
          "needs": {
            "description": "Another animal it needs to move, e.g. a cart needs a mule",
            "$ref": "#/$defs/__schema0"
          },
          "roadsOnly": {
            "default": false,
            "description": "Keeps to roads: never on paths to sites (unused since carts may leave roads, 2026-11-13)",
            "$ref": "#/$defs/__schema4"
          },
          "maxPathDanger": {
            "description": "Only takes paths to sites up to this pathDanger (horses avoid rough paths)",
            "$ref": "#/$defs/__schema5"
          },
          "waterPerDay": {
            "default": 1,
            "description": "Units of water it drinks per day (halves allowed); the total for all animals is rounded up to whole units",
            "$ref": "#/$defs/__schema6"
          },
          "stealable": {
            "default": false,
            "description": "Thieves can lead it away (an `animals` loss without a named animal)",
            "$ref": "#/$defs/__schema7"
          },
          "vehicle": {
            "default": false,
            "description": "A vehicle (cart, wagon): each working one adds VEHICLE_HOSTILE to the hostile share",
            "$ref": "#/$defs/__schema8"
          },
          "slow": {
            "default": false,
            "description": "Slow: while the party has a working one, the brisk and forced paces are unavailable",
            "$ref": "#/$defs/__schema9"
          },
          "flies": {
            "default": false,
            "description": "Flies (the flying carpet): when it is the party's only animal, it carries the whole party and `capacity` kg whatever their strength, at `speed` on any terrain and any path; with other animals it is rolled up and carries nothing",
            "$ref": "#/$defs/__schema10"
          },
          "desertWater": {
            "default": false,
            "description": "Camels: in the desert each one cuts the party’s water by CAMEL_DESERT_WATER_SAVING, up to CAMEL_DESERT_WATER_MAX",
            "$ref": "#/$defs/__schema11"
          },
          "soldIn": {
            "description": "Sold only at animals services in settlements that match; omit to sell it at every one",
            "$ref": "#/$defs/__schema12"
          }
        },
        "required": [
          "id",
          "name",
          "price",
          "capacity"
        ]
      }
    }
  },
  "required": [
    "kind",
    "source",
    "entries"
  ],
  "$defs": {
    "__schema0": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "__schema1": {
      "type": "number",
      "minimum": 0
    },
    "__schema2": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "__schema3": {
      "type": "boolean"
    },
    "__schema4": {
      "type": "boolean"
    },
    "__schema5": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "__schema6": {
      "type": "number",
      "minimum": 0,
      "multipleOf": 0.5
    },
    "__schema7": {
      "type": "boolean"
    },
    "__schema8": {
      "type": "boolean"
    },
    "__schema9": {
      "type": "boolean"
    },
    "__schema10": {
      "type": "boolean"
    },
    "__schema11": {
      "type": "boolean"
    },
    "__schema12": {
      "type": "object",
      "properties": {
        "biomes": {
          "description": "The settlement's land is one of these",
          "$ref": "#/$defs/__schema13"
        },
        "minSizeTier": {
          "description": "At least this size",
          "$ref": "#/$defs/__schema15"
        }
      }
    },
    "__schema13": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema14"
      }
    },
    "__schema14": {
      "type": "string",
      "enum": [
        "plains",
        "forest",
        "hills",
        "mountains",
        "marsh",
        "desert",
        "jungle",
        "sea"
      ]
    },
    "__schema15": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    }
  }
}
