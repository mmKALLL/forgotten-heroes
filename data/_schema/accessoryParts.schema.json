{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "const": "accessoryParts"
    },
    "source": {
      "type": "string",
      "enum": [
        "original",
        "imported",
        "imported-private",
        "procedural",
        "claude"
      ]
    },
    "notes": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/__schema0"
          },
          "part": {
            "$ref": "#/$defs/__schema1"
          },
          "name": {
            "$ref": "#/$defs/__schema2"
          },
          "weight": {
            "$ref": "#/$defs/__schema3"
          },
          "minTier": {
            "$ref": "#/$defs/__schema5"
          },
          "value": {
            "$ref": "#/$defs/__schema7"
          },
          "hook": {
            "$ref": "#/$defs/__schema8"
          },
          "bases": {
            "$ref": "#/$defs/__schema32"
          },
          "notes": {
            "$ref": "#/$defs/__schema34"
          }
        },
        "required": [
          "id",
          "part",
          "name",
          "value"
        ]
      }
    }
  },
  "required": [
    "kind",
    "source",
    "entries"
  ],
  "$defs": {
    "__schema0": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "__schema1": {
      "type": "string",
      "enum": [
        "base",
        "prefix",
        "suffix"
      ]
    },
    "__schema2": {
      "type": "string",
      "description": "\"Ring\", \"Fox-eyed\", \"of the Long Road\""
    },
    "__schema3": {
      "default": 1,
      "description": "Relative chance of being rolled",
      "$ref": "#/$defs/__schema4"
    },
    "__schema4": {
      "type": "number",
      "minimum": 0
    },
    "__schema5": {
      "default": 1,
      "description": "Rolled only on accessories of this tier or higher",
      "$ref": "#/$defs/__schema6"
    },
    "__schema6": {
      "anyOf": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        }
      ]
    },
    "__schema7": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "gp added to the accessory's value"
    },
    "__schema8": {
      "description": "What an affix does; a base has none",
      "$ref": "#/$defs/__schema9"
    },
    "__schema9": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "hook": {
              "$ref": "#/$defs/__schema10"
            },
            "skill": {
              "$ref": "#/$defs/__schema11"
            },
            "amount": {
              "$ref": "#/$defs/__schema12"
            }
          },
          "required": [
            "hook",
            "skill",
            "amount"
          ],
          "description": "Wearer: + to that skill's checks"
        },
        {
          "type": "object",
          "properties": {
            "hook": {
              "$ref": "#/$defs/__schema13"
            },
            "activity": {
              "$ref": "#/$defs/__schema14"
            },
            "amount": {
              "$ref": "#/$defs/__schema15"
            }
          },
          "required": [
            "hook",
            "activity",
            "amount"
          ],
          "description": "Wearer: + when they lead that activity (forage, gather, explore, rumours, stowaway)"
        },
        {
          "type": "object",
          "properties": {
            "hook": {
              "$ref": "#/$defs/__schema16"
            },
            "amount": {
              "$ref": "#/$defs/__schema17"
            }
          },
          "required": [
            "hook",
            "amount"
          ],
          "description": "Wearer: + to CON checks against exhaustion (hunger, thirst, forced march)"
        },
        {
          "type": "object",
          "properties": {
            "hook": {
              "$ref": "#/$defs/__schema18"
            },
            "kg": {
              "$ref": "#/$defs/__schema19"
            }
          },
          "required": [
            "hook",
            "kg"
          ],
          "description": "Wearer: + carrying capacity in kg"
        },
        {
          "type": "object",
          "properties": {
            "hook": {
              "$ref": "#/$defs/__schema20"
            },
            "amount": {
              "$ref": "#/$defs/__schema21"
            }
          },
          "required": [
            "hook",
            "amount"
          ],
          "description": "Wearer: + max HP while worn (applied on equip, removed on unequip)"
        },
        {
          "type": "object",
          "properties": {
            "hook": {
              "$ref": "#/$defs/__schema22"
            },
            "amount": {
              "$ref": "#/$defs/__schema23"
            }
          },
          "required": [
            "hook"
          ],
          "description": "Wearer: Strain fades this many more stacks a day"
        },
        {
          "type": "object",
          "properties": {
            "hook": {
              "$ref": "#/$defs/__schema24"
            },
            "amount": {
              "$ref": "#/$defs/__schema25"
            }
          },
          "required": [
            "hook"
          ],
          "description": "Wearer: the daily Strain threshold is this much higher"
        },
        {
          "type": "object",
          "properties": {
            "hook": {
              "$ref": "#/$defs/__schema26"
            }
          },
          "required": [
            "hook"
          ],
          "description": "Wearer: once a day, rerolls a natural 1 on the wearer's encounter check"
        },
        {
          "type": "object",
          "properties": {
            "hook": {
              "$ref": "#/$defs/__schema27"
            },
            "category": {
              "$ref": "#/$defs/__schema28"
            },
            "share": {
              "$ref": "#/$defs/__schema29"
            }
          },
          "required": [
            "hook",
            "category",
            "share"
          ],
          "description": "Party: selling goods of that category pays this share more (before rounding)"
        },
        {
          "type": "object",
          "properties": {
            "hook": {
              "$ref": "#/$defs/__schema30"
            },
            "share": {
              "$ref": "#/$defs/__schema31"
            }
          },
          "required": [
            "hook",
            "share"
          ],
          "description": "Party: the road's hostile share is this much lower (the best ward counts)"
        }
      ]
    },
    "__schema10": {
      "type": "string",
      "const": "skill"
    },
    "__schema11": {
      "type": "string",
      "enum": [
        "acrobatics",
        "animalHandling",
        "arcana",
        "athletics",
        "deception",
        "history",
        "insight",
        "intimidation",
        "investigation",
        "medicine",
        "nature",
        "perception",
        "performance",
        "persuasion",
        "religion",
        "sleightOfHand",
        "stealth",
        "survival"
      ]
    },
    "__schema12": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "__schema13": {
      "type": "string",
      "const": "activity"
    },
    "__schema14": {
      "type": "string",
      "enum": [
        "forage",
        "gather",
        "explore",
        "rumours",
        "stowaway"
      ]
    },
    "__schema15": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "__schema16": {
      "type": "string",
      "const": "endurance"
    },
    "__schema17": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "__schema18": {
      "type": "string",
      "const": "carry"
    },
    "__schema19": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "__schema20": {
      "type": "string",
      "const": "maxHp"
    },
    "__schema21": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "__schema22": {
      "type": "string",
      "const": "strainFade"
    },
    "__schema23": {
      "default": 1,
      "type": "number",
      "const": 1
    },
    "__schema24": {
      "type": "string",
      "const": "strainGrace"
    },
    "__schema25": {
      "default": 1,
      "type": "number",
      "const": 1
    },
    "__schema26": {
      "type": "string",
      "const": "lucky"
    },
    "__schema27": {
      "type": "string",
      "const": "sellBonus"
    },
    "__schema28": {
      "type": "string",
      "enum": [
        "essentials",
        "consumables",
        "equipment",
        "materials",
        "precious"
      ]
    },
    "__schema29": {
      "type": "number",
      "minimum": 0.05,
      "maximum": 0.2
    },
    "__schema30": {
      "type": "string",
      "const": "ward"
    },
    "__schema31": {
      "type": "number",
      "minimum": 0.02,
      "maximum": 0.1
    },
    "__schema32": {
      "description": "An affix: only on these bases (default any)",
      "$ref": "#/$defs/__schema33"
    },
    "__schema33": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "__schema34": {
      "type": "string"
    }
  }
}
