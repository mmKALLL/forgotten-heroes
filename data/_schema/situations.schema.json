{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "const": "situations"
    },
    "source": {
      "type": "string",
      "enum": [
        "original",
        "imported",
        "imported-private",
        "procedural",
        "claude"
      ]
    },
    "notes": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/__schema0"
          },
          "title": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "weight": {
            "default": 1,
            "description": "Relative chance in a random draw",
            "$ref": "#/$defs/__schema1"
          },
          "tags": {
            "default": [],
            "description": "Themes, e.g. \"road\"; biomes and regions filter where it happens. Visible wealth makes \"thieves\" and \"toll\" situations likelier",
            "$ref": "#/$defs/__schema2"
          },
          "biomes": {
            "description": "Only drawn on the road in these terrains; omit for anywhere on land. \"sea\" for ships.",
            "$ref": "#/$defs/__schema3"
          },
          "regions": {
            "description": "Only drawn on the road in these regions; omit for anywhere",
            "$ref": "#/$defs/__schema4"
          },
          "disposition": {
            "description": "How it treats the party. A stealthy party avoids some hostile encounters and meets the rest on better footing. Required (by the lint) unless followUpOnly; wonders are never hostile.",
            "$ref": "#/$defs/__schema5"
          },
          "slots": {
            "default": {},
            "description": "Filled when the encounter starts",
            "$ref": "#/$defs/__schema6"
          },
          "twist": {
            "type": "object",
            "properties": {
              "chance": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Rolled secretly when the encounter starts"
              },
              "what": {
                "type": "string",
                "description": "Always shown, e.g. \"they are bait for an ambush\"; Insight reveals the chance. With the twist table keep it vague (\"they are not what they seem\"): the kind stays hidden."
              },
              "table": {
                "default": false,
                "description": "Draw the twist kind from the twist table (data/procedural) when the encounter starts. Its stages join the situation, and \"@twist\" goes to them.",
                "$ref": "#/$defs/__schema8"
              },
              "kinds": {
                "description": "With the table: only these twist kinds can be drawn",
                "$ref": "#/$defs/__schema9"
              },
              "stage": {
                "description": "A bespoke twist's escalation stage: where \"@twist\" goes. Set by the engine for table twists.",
                "$ref": "#/$defs/__schema0"
              },
              "opening": {
                "default": [],
                "description": "A bespoke twist's opening hit, applied by { \"effect\": \"openingHit\" }. Set by the engine for table twists.",
                "$ref": "#/$defs/__schema10"
              }
            },
            "required": [
              "chance",
              "what"
            ]
          },
          "wonder": {
            "default": false,
            "description": "One click, flavour only, never a cost",
            "$ref": "#/$defs/__schema85"
          },
          "followUpOnly": {
            "default": false,
            "description": "Never drawn at random; only queued by followUp",
            "$ref": "#/$defs/__schema86"
          },
          "site": {
            "default": false,
            "description": "Only played at a point of interest; never drawn on the road",
            "$ref": "#/$defs/__schema87"
          },
          "room": {
            "default": false,
            "description": "A dungeon room (with site: true): played only in a delve, never on the road or at an ordinary site",
            "$ref": "#/$defs/__schema88"
          },
          "pursuit": {
            "description": "A follow-up that hunts the party down. When it comes due, the pace since it was queued decides: covered tracks lose it, a brisk or faster march outruns it, slower lets it catch up.",
            "$ref": "#/$defs/__schema89"
          },
          "villains": {
            "default": [],
            "description": "Villain ids: an omen, drawn on the road only while one of these villains' Crisis is undecided",
            "$ref": "#/$defs/__schema90"
          },
          "start": {
            "default": "start",
            "$ref": "#/$defs/__schema0"
          },
          "stages": {
            "type": "object",
            "propertyNames": {
              "$ref": "#/$defs/__schema0"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string"
                },
                "archetype": {
                  "description": "Its options come first, then this stage's own",
                  "$ref": "#/$defs/__schema91"
                },
                "options": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "id": {
                            "$ref": "#/$defs/__schema94"
                          },
                          "label": {
                            "$ref": "#/$defs/__schema95"
                          },
                          "description": {
                            "$ref": "#/$defs/__schema96"
                          },
                          "tags": {
                            "$ref": "#/$defs/__schema97"
                          },
                          "requires": {
                            "$ref": "#/$defs/__schema99"
                          },
                          "once": {
                            "$ref": "#/$defs/__schema110"
                          },
                          "kind": {
                            "type": "string",
                            "const": "check"
                          },
                          "check": {
                            "type": "object",
                            "properties": {
                              "skill": {
                                "$ref": "#/$defs/__schema49"
                              },
                              "ability": {
                                "description": "Overrides the skill's default ability, e.g. \"cha\" for Intimidation (CHA)",
                                "$ref": "#/$defs/__schema112"
                              },
                              "dc": {
                                "anyOf": [
                                  {
                                    "$ref": "#/$defs/__schema113"
                                  },
                                  {
                                    "$ref": "#/$defs/__schema114"
                                  }
                                ],
                                "description": "A DC from 1 to 40, or inside an archetype \"dc\", \"dc+2\" or \"dc-1\""
                              },
                              "combat": {
                                "description": "Combat checks never grant Inspiration on a natural 20",
                                "$ref": "#/$defs/__schema115"
                              }
                            },
                            "required": [
                              "skill",
                              "dc"
                            ]
                          },
                          "highStakes": {
                            "description": "Force the slow, glowing dice roll",
                            "$ref": "#/$defs/__schema116"
                          },
                          "outcomes": {
                            "type": "object",
                            "properties": {
                              "critFail": {
                                "description": "Defaults to the fail outcome",
                                "$ref": "#/$defs/__schema117"
                              },
                              "fail": {
                                "$ref": "#/$defs/__schema117"
                              },
                              "partial": {
                                "$ref": "#/$defs/__schema117"
                              },
                              "success": {
                                "$ref": "#/$defs/__schema117"
                              },
                              "critSuccess": {
                                "description": "Defaults to the success outcome",
                                "$ref": "#/$defs/__schema117"
                              }
                            },
                            "required": [
                              "fail",
                              "partial",
                              "success"
                            ]
                          }
                        },
                        "required": [
                          "id",
                          "label",
                          "kind",
                          "check",
                          "outcomes"
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "id": {
                            "$ref": "#/$defs/__schema94"
                          },
                          "label": {
                            "$ref": "#/$defs/__schema95"
                          },
                          "description": {
                            "$ref": "#/$defs/__schema96"
                          },
                          "tags": {
                            "$ref": "#/$defs/__schema97"
                          },
                          "requires": {
                            "$ref": "#/$defs/__schema99"
                          },
                          "once": {
                            "$ref": "#/$defs/__schema110"
                          },
                          "kind": {
                            "type": "string",
                            "const": "fixed"
                          },
                          "outcome": {
                            "$ref": "#/$defs/__schema117"
                          }
                        },
                        "required": [
                          "id",
                          "label",
                          "kind",
                          "outcome"
                        ]
                      }
                    ]
                  }
                },
                "challenge": {
                  "description": "Makes the stage a skill challenge: its options are rounds that mark a tally",
                  "$ref": "#/$defs/__schema127"
                }
              },
              "required": [
                "text"
              ]
            }
          }
        },
        "required": [
          "id",
          "title",
          "stages"
        ]
      }
    }
  },
  "required": [
    "kind",
    "source",
    "entries"
  ],
  "$defs": {
    "__schema0": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "__schema1": {
      "type": "number",
      "minimum": 0
    },
    "__schema2": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "__schema3": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "plains",
          "forest",
          "hills",
          "mountains",
          "marsh",
          "desert",
          "jungle",
          "sea"
        ]
      }
    },
    "__schema4": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "__schema5": {
      "type": "string",
      "enum": [
        "hostile",
        "neutral",
        "pleasant"
      ]
    },
    "__schema6": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/__schema0"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "const": "table"
              },
              "table": {
                "description": "A parts table id",
                "$ref": "#/$defs/__schema0"
              }
            },
            "required": [
              "from",
              "table"
            ]
          },
          {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "const": "creature"
              },
              "types": {
                "default": [],
                "description": "Empty means any type",
                "$ref": "#/$defs/__schema7"
              },
              "maxCr": {
                "type": "number",
                "minimum": 0
              },
              "form": {
                "default": "group",
                "type": "string",
                "enum": [
                  "group",
                  "name"
                ]
              }
            },
            "required": [
              "from"
            ]
          }
        ]
      }
    },
    "__schema7": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "aberration",
          "beast",
          "celestial",
          "construct",
          "dragon",
          "elemental",
          "fey",
          "fiend",
          "giant",
          "humanoid",
          "monstrosity",
          "ooze",
          "plant",
          "undead"
        ]
      }
    },
    "__schema8": {
      "type": "boolean"
    },
    "__schema9": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "__schema10": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema11"
      }
    },
    "__schema11": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "effect": {
              "$ref": "#/$defs/__schema12"
            },
            "amount": {
              "$ref": "#/$defs/__schema13"
            },
            "if": {
              "$ref": "#/$defs/__schema14"
            }
          },
          "required": [
            "effect",
            "amount"
          ],
          "description": "Gain or lose gold; gold never drops below 0"
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "$ref": "#/$defs/__schema19"
            },
            "amount": {
              "$ref": "#/$defs/__schema13"
            },
            "target": {
              "$ref": "#/$defs/__schema20"
            },
            "if": {
              "$ref": "#/$defs/__schema14"
            }
          },
          "required": [
            "effect",
            "amount",
            "target"
          ],
          "description": "Heal (+) or hurt (−) the acting member, everyone, or one random member who can still act"
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "$ref": "#/$defs/__schema21"
            },
            "fraction": {
              "$ref": "#/$defs/__schema22"
            },
            "target": {
              "$ref": "#/$defs/__schema23"
            },
            "if": {
              "$ref": "#/$defs/__schema14"
            }
          },
          "required": [
            "effect",
            "fraction",
            "target"
          ],
          "description": "Heal a share of each target's max HP, rounded up (0.25 heals a quarter): the acting member, everyone, or one random member who can still act"
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "$ref": "#/$defs/__schema24"
            },
            "amount": {
              "$ref": "#/$defs/__schema13"
            },
            "target": {
              "$ref": "#/$defs/__schema25"
            },
            "if": {
              "$ref": "#/$defs/__schema14"
            }
          },
          "required": [
            "effect",
            "amount",
            "target"
          ],
