        {
          "type": "object",
          "properties": {
            "effect": {
              "$ref": "#/$defs/__schema71"
            },
            "amount": {
              "$ref": "#/$defs/__schema72"
            },
            "if": {
              "$ref": "#/$defs/__schema14"
            }
          },
          "required": [
            "effect"
          ],
          "description": "A clue to the open act of the Crisis: it adds to that act's clues (two reveal its lead site, three its weakness at the key site). In act I before the plan, it reveals the lead"
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "$ref": "#/$defs/__schema73"
