        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "$ref": "#/$defs/__schema29"
            },
            "position": {
              "$ref": "#/$defs/__schema30"
            },
            "if": {
              "$ref": "#/$defs/__schema14"
            }
          },
          "required": [
            "effect",
            "position"
          ],
          "description": "Edge or Exposed for the next check in this encounter"
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "$ref": "#/$defs/__schema31"
            },
            "situation": {
              "$ref": "#/$defs/__schema0"
            },
            "after": {
              "$ref": "#/$defs/__schema32"
            },
            "if": {
              "$ref": "#/$defs/__schema14"
            }
          },
          "required": [
            "effect",
            "situation"
          ],
          "description": "Queue a later encounter"
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "$ref": "#/$defs/__schema34"
            },
            "amount": {
              "$ref": "#/$defs/__schema13"
            },
            "reason": {
              "$ref": "#/$defs/__schema35"
            },
            "if": {
              "$ref": "#/$defs/__schema14"
            }
          },
          "required": [
            "effect",
            "amount"
          ],
          "description": "Add to the party's next check in this encounter (e.g. −2 after misreading a situation)"
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "$ref": "#/$defs/__schema37"
            },
            "kind": {
              "$ref": "#/$defs/__schema38"
            },
            "if": {
              "$ref": "#/$defs/__schema14"
            }
          },
          "required": [
            "effect"
          ],
          "description": "Show the odds of the hidden twist"
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "$ref": "#/$defs/__schema40"
            },
            "if": {
              "$ref": "#/$defs/__schema14"
            }
          },
          "required": [
            "effect"
          ],
          "description": "The twist's opening hit: the drawn twist kind's opening effects, or a bespoke twist's `opening`. Only in twist branches."
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "type": "string",
              "const": "log"
            },
            "text": {
              "type": "string"
            },
            "tone": {
              "default": "info",
              "type": "string",
              "enum": [
                "info",
                "good",
                "bad",
                "crit"
              ]
            },
            "if": {
              "$ref": "#/$defs/__schema14"
            }
          },
          "required": [
            "effect",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "$ref": "#/$defs/__schema41"
            },
            "count": {
              "$ref": "#/$defs/__schema42"
            },
            "scope": {
              "$ref": "#/$defs/__schema43"
            },
