          "required": [
            "effect"
          ],
          "description": "Act I's lead won: the party learns the villain's plan and finds the act's key site. It works as revealKeySite, at the current act's lead site only"
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "$ref": "#/$defs/__schema70"
            },
            "if": {
              "$ref": "#/$defs/__schema14"
            }
          },
          "required": [
            "effect"
          ],
          "description": "Wins the current act's lead: its key site is found and the prevention begins. Only works at that act's lead site (at act I's, the plan is learned too)"
