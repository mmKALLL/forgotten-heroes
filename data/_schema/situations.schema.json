        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "$ref": "#/$defs/__schema26"
            },
            "amount": {
              "$ref": "#/$defs/__schema13"
            },
            "if": {
              "$ref": "#/$defs/__schema14"
            }
          },
          "required": [
            "effect",
            "amount"
          ],
          "description": "Gain (+) or lose (−) Inspiration; it never drops below 0"
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "$ref": "#/$defs/__schema27"
            },
            "amount": {
              "$ref": "#/$defs/__schema28"
            },
            "if": {
              "$ref": "#/$defs/__schema14"
            }
          },
          "required": [
            "effect",
            "amount"
          ],
