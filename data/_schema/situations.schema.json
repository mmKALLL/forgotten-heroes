{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "const": "situations"
    },
    "source": {
      "type": "string",
      "enum": [
        "original",
        "imported",
        "imported-private",
        "procedural",
        "claude"
      ]
    },
    "notes": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/__schema0"
          },
          "title": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "weight": {
            "default": 1,
            "description": "Relative chance in a random draw",
            "$ref": "#/$defs/__schema1"
          },
          "tags": {
            "default": [],
            "description": "Themes, e.g. \"road\"; biomes and regions filter where it happens",
            "$ref": "#/$defs/__schema2"
          },
          "biomes": {
            "description": "Only drawn on the road in these terrains; omit for anywhere on land. \"sea\" for ships.",
            "$ref": "#/$defs/__schema3"
          },
          "regions": {
            "description": "Only drawn on the road in these regions; omit for anywhere",
            "$ref": "#/$defs/__schema4"
          },
          "disposition": {
            "description": "How it treats the party. A cautious party avoids some hostile encounters and meets the rest on better footing. Required (by the lint) unless followUpOnly; wonders are never hostile.",
            "$ref": "#/$defs/__schema5"
          },
          "slots": {
            "default": {},
            "description": "Filled when the encounter starts",
            "$ref": "#/$defs/__schema6"
          },
          "twist": {
            "type": "object",
            "properties": {
              "chance": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Rolled secretly when the encounter starts"
              },
              "what": {
                "type": "string",
                "description": "Always shown, e.g. \"they are bait for an ambush\"; Insight reveals the chance. With the twist table keep it vague (\"they are not what they seem\"): the kind stays hidden."
              },
              "table": {
                "default": false,
                "description": "Draw the twist kind from the twist table (data/procedural) when the encounter starts. Its stages join the situation, and \"@twist\" goes to them.",
                "$ref": "#/$defs/__schema8"
              },
              "kinds": {
                "description": "With the table: only these twist kinds can be drawn",
                "$ref": "#/$defs/__schema9"
              },
              "stage": {
                "description": "A bespoke twist's escalation stage: where \"@twist\" goes. Set by the engine for table twists.",
                "$ref": "#/$defs/__schema0"
              },
              "opening": {
                "default": [],
                "description": "A bespoke twist's opening hit, applied by { \"effect\": \"openingHit\" }. Set by the engine for table twists.",
                "$ref": "#/$defs/__schema10"
              }
            },
            "required": [
              "chance",
              "what"
            ]
          },
          "wonder": {
            "default": false,
            "description": "One click, flavour only, never a cost",
            "$ref": "#/$defs/__schema47"
          },
          "followUpOnly": {
            "default": false,
            "description": "Never drawn at random; only queued by followUp",
            "$ref": "#/$defs/__schema48"
          },
          "site": {
            "default": false,
            "description": "Only played at a point of interest; never drawn on the road",
            "$ref": "#/$defs/__schema49"
          },
          "pursuit": {
            "description": "A follow-up that hunts the party down. When it comes due, the pace since it was queued decides: covered tracks lose it, a brisk or faster march outruns it, slower lets it catch up.",
            "$ref": "#/$defs/__schema50"
          },
          "start": {
            "default": "start",
            "$ref": "#/$defs/__schema0"
          },
          "stages": {
            "type": "object",
            "propertyNames": {
              "$ref": "#/$defs/__schema0"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string"
                },
                "archetype": {
                  "description": "Its options come first, then this stage's own",
                  "$ref": "#/$defs/__schema51"
                },
                "options": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "id": {
                            "$ref": "#/$defs/__schema54"
                          },
                          "label": {
                            "$ref": "#/$defs/__schema55"
                          },
                          "description": {
                            "$ref": "#/$defs/__schema56"
                          },
                          "requires": {
                            "$ref": "#/$defs/__schema57"
                          },
                          "once": {
                            "$ref": "#/$defs/__schema60"
                          },
                          "kind": {
                            "type": "string",
                            "const": "check"
                          },
                          "check": {
                            "type": "object",
                            "properties": {
                              "skill": {
                                "$ref": "#/$defs/__schema46"
                              },
                              "ability": {
                                "description": "Overrides the skill's default ability, e.g. \"cha\" for Intimidation (CHA)",
                                "$ref": "#/$defs/__schema62"
                              },
                              "dc": {
                                "anyOf": [
                                  {
                                    "$ref": "#/$defs/__schema63"
                                  },
                                  {
                                    "$ref": "#/$defs/__schema64"
                                  }
                                ],
                                "description": "A DC from 1 to 40, or inside an archetype \"dc\", \"dc+2\" or \"dc-1\""
                              },
                              "combat": {
                                "description": "Combat checks never grant Inspiration on a natural 20",
                                "$ref": "#/$defs/__schema65"
                              }
                            },
                            "required": [
                              "skill",
                              "dc"
                            ]
                          },
                          "highStakes": {
                            "description": "Force the slow, glowing dice roll",
                            "$ref": "#/$defs/__schema66"
                          },
                          "outcomes": {
                            "type": "object",
                            "properties": {
                              "critFail": {
                                "description": "Defaults to the fail outcome",
                                "$ref": "#/$defs/__schema67"
                              },
                              "fail": {
                                "$ref": "#/$defs/__schema67"
                              },
                              "partial": {
                                "$ref": "#/$defs/__schema67"
                              },
                              "success": {
                                "$ref": "#/$defs/__schema67"
                              },
                              "critSuccess": {
                                "description": "Defaults to the success outcome",
                                "$ref": "#/$defs/__schema67"
                              }
                            },
                            "required": [
                              "fail",
                              "partial",
                              "success"
                            ]
                          }
                        },
                        "required": [
                          "id",
                          "label",
                          "kind",
                          "check",
                          "outcomes"
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "id": {
                            "$ref": "#/$defs/__schema54"
                          },
                          "label": {
                            "$ref": "#/$defs/__schema55"
                          },
                          "description": {
                            "$ref": "#/$defs/__schema56"
                          },
                          "requires": {
                            "$ref": "#/$defs/__schema57"
                          },
                          "once": {
                            "$ref": "#/$defs/__schema60"
                          },
                          "kind": {
                            "type": "string",
                            "const": "fixed"
                          },
                          "outcome": {
                            "$ref": "#/$defs/__schema67"
                          }
                        },
                        "required": [
                          "id",
                          "label",
                          "kind",
                          "outcome"
                        ]
                      }
                    ]
                  }
                }
              },
              "required": [
                "text"
              ]
            }
          }
        },
        "required": [
          "id",
          "title",
          "stages"
        ]
      }
    }
  },
  "required": [
    "kind",
    "source",
    "entries"
  ],
  "$defs": {
    "__schema0": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "__schema1": {
      "type": "number",
      "minimum": 0
    },
    "__schema2": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "__schema3": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "plains",
          "forest",
          "hills",
          "mountains",
          "marsh",
          "desert",
          "jungle",
          "sea"
        ]
      }
    },
    "__schema4": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "__schema5": {
      "type": "string",
      "enum": [
        "hostile",
        "neutral",
        "pleasant"
      ]
    },
    "__schema6": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/__schema0"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "const": "table"
              },
              "table": {
                "description": "A parts table id",
                "$ref": "#/$defs/__schema0"
              }
            },
            "required": [
              "from",
              "table"
            ]
          },
          {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "const": "creature"
              },
              "types": {
                "default": [],
                "description": "Empty means any type",
                "$ref": "#/$defs/__schema7"
              },
              "maxCr": {
                "type": "number",
                "minimum": 0
              },
              "form": {
                "default": "group",
                "type": "string",
                "enum": [
                  "group",
                  "name"
                ]
              }
            },
            "required": [
              "from"
            ]
          }
        ]
      }
    },
    "__schema7": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "aberration",
          "beast",
          "celestial",
          "construct",
          "dragon",
          "elemental",
          "fey",
          "fiend",
          "giant",
          "humanoid",
          "monstrosity",
          "ooze",
          "plant",
          "undead"
        ]
      }
    },
    "__schema8": {
      "type": "boolean"
    },
    "__schema9": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "__schema10": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema11"
      }
    },
    "__schema11": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "effect": {
              "$ref": "#/$defs/__schema12"
            },
            "amount": {
              "$ref": "#/$defs/__schema13"
            },
            "if": {
              "$ref": "#/$defs/__schema14"
            }
          },
          "required": [
            "effect",
            "amount"
          ],
          "description": "Gain or lose gold; gold never drops below 0"
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "$ref": "#/$defs/__schema19"
            },
            "amount": {
              "$ref": "#/$defs/__schema13"
            },
            "target": {
              "$ref": "#/$defs/__schema20"
            },
            "if": {
              "$ref": "#/$defs/__schema14"
            }
          },
          "required": [
            "effect",
            "amount",
            "target"
          ],
          "description": "Heal (+) or hurt (−) the acting member, everyone, or one random member who can still act"
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "$ref": "#/$defs/__schema21"
            },
            "amount": {
              "$ref": "#/$defs/__schema13"
            },
            "target": {
              "$ref": "#/$defs/__schema22"
            },
            "if": {
              "$ref": "#/$defs/__schema14"
            }
          },
          "required": [
            "effect",
            "amount",
            "target"
          ],
          "description": "Add (+) or remove (−) exhaustion levels"
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "$ref": "#/$defs/__schema23"
            },
            "amount": {
              "$ref": "#/$defs/__schema13"
            },
            "if": {
              "$ref": "#/$defs/__schema14"
            }
          },
          "required": [
            "effect",
            "amount"
          ],
          "description": "Gain (+) or lose (−) Inspiration; it never drops below 0"
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "$ref": "#/$defs/__schema24"
            },
            "amount": {
              "$ref": "#/$defs/__schema25"
            },
            "if": {
              "$ref": "#/$defs/__schema14"
            }
          },
          "required": [
            "effect",
            "amount"
          ],
          "description": "Time passes"
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "$ref": "#/$defs/__schema26"
            },
            "position": {
              "$ref": "#/$defs/__schema27"
            },
            "if": {
              "$ref": "#/$defs/__schema14"
            }
          },
          "required": [
            "effect",
            "position"
          ],
          "description": "Edge or Exposed for the next check in this encounter"
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "$ref": "#/$defs/__schema28"
            },
            "situation": {
              "$ref": "#/$defs/__schema0"
            },
            "after": {
              "$ref": "#/$defs/__schema29"
            },
            "if": {
              "$ref": "#/$defs/__schema14"
            }
          },
          "required": [
            "effect",
            "situation"
          ],
          "description": "Queue a later encounter"
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "$ref": "#/$defs/__schema31"
            },
            "amount": {
              "$ref": "#/$defs/__schema13"
            },
            "reason": {
              "$ref": "#/$defs/__schema32"
            },
            "if": {
              "$ref": "#/$defs/__schema14"
            }
          },
          "required": [
            "effect",
            "amount"
          ],
          "description": "Add to the party's next check in this encounter (e.g. −2 after misreading a situation)"
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "$ref": "#/$defs/__schema34"
            },
            "kind": {
              "$ref": "#/$defs/__schema35"
            },
            "if": {
              "$ref": "#/$defs/__schema14"
            }
          },
          "required": [
            "effect"
          ],
          "description": "Show the odds of the hidden twist"
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "$ref": "#/$defs/__schema37"
            },
            "if": {
              "$ref": "#/$defs/__schema14"
            }
          },
          "required": [
            "effect"
          ],
          "description": "The twist's opening hit: the drawn twist kind's opening effects, or a bespoke twist's `opening`. Only in twist branches."
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "type": "string",
              "const": "log"
            },
            "text": {
              "type": "string"
            },
            "tone": {
              "default": "info",
              "type": "string",
              "enum": [
                "info",
                "good",
                "bad",
                "crit"
              ]
            },
            "if": {
              "$ref": "#/$defs/__schema14"
            }
          },
          "required": [
            "effect",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "$ref": "#/$defs/__schema38"
            },
            "count": {
              "$ref": "#/$defs/__schema39"
            },
            "scope": {
              "$ref": "#/$defs/__schema40"
            },
            "category": {
              "$ref": "#/$defs/__schema42"
            },
            "if": {
              "$ref": "#/$defs/__schema14"
            }
          },
          "required": [
            "effect"
          ],
          "description": "Reveal the nearest undiscovered points of interest to the encounter's domain (a clue)"
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "$ref": "#/$defs/__schema44"
            },
            "if": {
              "$ref": "#/$defs/__schema14"
            }
          },
          "required": [
            "effect"
          ],
          "description": "Clear the point of interest being visited, so it no longer feeds its domain's threat"
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "$ref": "#/$defs/__schema45"
            },
            "skill": {
              "$ref": "#/$defs/__schema46"
            },
            "if": {
              "$ref": "#/$defs/__schema14"
            }
          },
          "required": [
            "effect",
            "skill"
          ],
          "description": "Make the best-suited member who lacks the skill proficient in it (ties: party order)"
        }
      ]
    },
    "__schema12": {
      "type": "string",
      "const": "gold"
    },
    "__schema13": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "__schema14": {
      "description": "Only applies when this holds",
      "$ref": "#/$defs/__schema15"
    },
    "__schema15": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "cond": {
              "$ref": "#/$defs/__schema16"
            },
            "not": {
              "$ref": "#/$defs/__schema17"
            }
          },
          "required": [
            "cond"
          ],
          "description": "The twist's odds have been revealed earlier in the encounter (e.g. by Insight)"
        }
      ]
    },
    "__schema16": {
      "type": "string",
      "const": "twistRevealed"
    },
    "__schema17": {
      "description": "True: only when the odds are still hidden",
      "$ref": "#/$defs/__schema18"
    },
    "__schema18": {
      "type": "boolean"
    },
    "__schema19": {
      "type": "string",
      "const": "hp"
    },
    "__schema20": {
      "type": "string",
      "enum": [
        "actor",
        "all",
        "random"
      ]
    },
    "__schema21": {
      "type": "string",
      "const": "exhaustion"
    },
    "__schema22": {
      "type": "string",
      "enum": [
        "actor",
        "all"
      ]
    },
    "__schema23": {
      "type": "string",
      "const": "inspiration"
    },
    "__schema24": {
      "type": "string",
      "const": "days"
    },
    "__schema25": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "__schema26": {
      "type": "string",
      "const": "position"
    },
    "__schema27": {
      "type": "string",
      "enum": [
        "normal",
        "edge",
        "exposed"
      ]
    },
    "__schema28": {
      "type": "string",
      "const": "followUp"
    },
    "__schema29": {
      "default": 0,
      "description": "Other encounters that happen first",
      "$ref": "#/$defs/__schema30"
    },
    "__schema30": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema31": {
      "type": "string",
      "const": "nextCheckModifier"
    },
    "__schema32": {
      "description": "Shown next to the modifier, e.g. \"misread\"",
      "$ref": "#/$defs/__schema33"
    },
    "__schema33": {
      "type": "string"
    },
    "__schema34": {
      "type": "string",
      "const": "revealTwist"
    },
    "__schema35": {
      "description": "Also reveal which kind of twist it would be (twist-table twists)",
      "$ref": "#/$defs/__schema36"
    },
    "__schema36": {
      "type": "boolean"
    },
    "__schema37": {
      "type": "string",
      "const": "openingHit"
    },
    "__schema38": {
      "type": "string",
      "const": "discoverPoi"
    },
    "__schema39": {
      "default": 1,
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "__schema40": {
      "default": "domain",
      "description": "Where to look: the encounter's domain, or every domain of its land",
      "$ref": "#/$defs/__schema41"
    },
    "__schema41": {
      "type": "string",
      "enum": [
        "domain",
        "land"
      ]
    },
    "__schema42": {
      "description": "Only sites of this category",
      "$ref": "#/$defs/__schema43"
    },
    "__schema43": {
      "type": "string",
      "enum": [
        "dungeon",
        "expert",
        "lair",
        "shrine",
        "landmark",
        "wonder",
        "quest"
      ]
    },
    "__schema44": {
      "type": "string",
      "const": "clearPoi"
    },
    "__schema45": {
      "type": "string",
      "const": "trainSkill"
    },
    "__schema46": {
      "type": "string",
      "enum": [
        "acrobatics",
        "animalHandling",
        "arcana",
        "athletics",
        "deception",
        "history",
        "insight",
        "intimidation",
        "investigation",
        "medicine",
        "nature",
        "perception",
        "performance",
        "persuasion",
        "religion",
        "sleightOfHand",
        "stealth",
        "survival"
      ]
    },
    "__schema47": {
      "type": "boolean"
    },
    "__schema48": {
      "type": "boolean"
    },
    "__schema49": {
      "type": "boolean"
    },
    "__schema50": {
      "type": "boolean"
    },
    "__schema51": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "dc": {
          "default": 13,
          "description": "What \"dc\" means in the archetype",
          "$ref": "#/$defs/__schema52"
        },
        "reward": {
          "default": 1,
          "description": "Multiplies every gold amount in the archetype",
          "$ref": "#/$defs/__schema53"
        }
      },
      "required": [
        "id"
      ]
    },
    "__schema52": {
      "type": "integer",
      "minimum": 1,
      "maximum": 40
    },
    "__schema53": {
      "type": "number",
      "minimum": 0,
      "maximum": 10
    },
    "__schema54": {
      "description": "Unique within its stage",
      "$ref": "#/$defs/__schema0"
    },
    "__schema55": {
      "type": "string"
    },
    "__schema56": {
