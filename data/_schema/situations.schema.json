{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "const": "situations"
    },
    "source": {
      "type": "string",
      "enum": [
        "original",
        "imported",
        "imported-private",
        "procedural",
        "claude"
      ]
    },
    "notes": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/__schema0"
          },
          "title": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "weight": {
            "default": 1,
            "description": "Relative chance in a random draw",
            "$ref": "#/$defs/__schema1"
          },
          "tags": {
            "default": [],
            "description": "Biomes and themes, for later plans",
            "$ref": "#/$defs/__schema2"
          },
          "slots": {
            "default": {},
            "description": "Filled when the encounter starts",
            "$ref": "#/$defs/__schema3"
          },
          "twist": {
            "type": "object",
            "properties": {
              "chance": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Rolled secretly when the encounter starts"
              },
              "what": {
                "type": "string",
                "description": "Always shown, e.g. \"they are bait for an ambush\"; Insight reveals the chance"
              }
            },
            "required": [
              "chance",
              "what"
            ]
          },
          "wonder": {
            "default": false,
            "description": "One click, flavour only, never a cost",
            "$ref": "#/$defs/__schema5"
          },
          "followUpOnly": {
            "default": false,
            "description": "Never drawn at random; only queued by followUp",
            "$ref": "#/$defs/__schema6"
          },
          "start": {
            "default": "start",
            "$ref": "#/$defs/__schema0"
          },
          "stages": {
            "type": "object",
            "propertyNames": {
              "$ref": "#/$defs/__schema0"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string"
                },
                "archetype": {
                  "description": "Its options come first, then this stage's own",
                  "$ref": "#/$defs/__schema7"
                },
                "options": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "id": {
                            "$ref": "#/$defs/__schema10"
                          },
                          "label": {
                            "$ref": "#/$defs/__schema11"
                          },
                          "description": {
                            "$ref": "#/$defs/__schema12"
                          },
                          "requires": {
                            "$ref": "#/$defs/__schema13"
                          },
                          "once": {
                            "$ref": "#/$defs/__schema14"
                          },
                          "kind": {
                            "type": "string",
                            "const": "check"
                          },
                          "check": {
                            "type": "object",
                            "properties": {
                              "skill": {
                                "type": "string",
                                "enum": [
                                  "acrobatics",
                                  "animalHandling",
                                  "arcana",
                                  "athletics",
                                  "deception",
                                  "history",
                                  "insight",
                                  "intimidation",
                                  "investigation",
                                  "medicine",
                                  "nature",
                                  "perception",
                                  "performance",
                                  "persuasion",
                                  "religion",
                                  "sleightOfHand",
                                  "stealth",
                                  "survival"
                                ]
                              },
                              "ability": {
                                "description": "Overrides the skill's default ability, e.g. \"cha\" for Intimidation (CHA)",
                                "$ref": "#/$defs/__schema16"
                              },
                              "dc": {
                                "anyOf": [
                                  {
                                    "$ref": "#/$defs/__schema17"
                                  },
                                  {
                                    "$ref": "#/$defs/__schema18"
                                  }
                                ],
                                "description": "A DC from 1 to 40, or inside an archetype \"dc\", \"dc+2\" or \"dc-1\""
                              },
                              "combat": {
                                "description": "Combat checks never grant Inspiration on a natural 20",
                                "$ref": "#/$defs/__schema19"
                              }
                            },
                            "required": [
                              "skill",
                              "dc"
                            ]
                          },
                          "highStakes": {
                            "description": "Force the slow, glowing dice roll",
                            "$ref": "#/$defs/__schema20"
                          },
                          "outcomes": {
                            "type": "object",
                            "properties": {
                              "critFail": {
                                "description": "Defaults to the fail outcome",
                                "$ref": "#/$defs/__schema21"
                              },
                              "fail": {
                                "$ref": "#/$defs/__schema21"
                              },
                              "partial": {
                                "$ref": "#/$defs/__schema21"
                              },
                              "success": {
                                "$ref": "#/$defs/__schema21"
                              },
                              "critSuccess": {
                                "description": "Defaults to the success outcome",
                                "$ref": "#/$defs/__schema21"
                              }
                            },
                            "required": [
                              "fail",
                              "partial",
                              "success"
                            ]
                          }
                        },
                        "required": [
                          "id",
                          "label",
                          "kind",
                          "check",
                          "outcomes"
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "id": {
                            "$ref": "#/$defs/__schema10"
                          },
                          "label": {
                            "$ref": "#/$defs/__schema11"
                          },
                          "description": {
                            "$ref": "#/$defs/__schema12"
                          },
                          "requires": {
                            "$ref": "#/$defs/__schema13"
                          },
                          "once": {
                            "$ref": "#/$defs/__schema14"
                          },
                          "kind": {
                            "type": "string",
                            "const": "fixed"
                          },
                          "outcome": {
                            "$ref": "#/$defs/__schema21"
                          }
                        },
                        "required": [
                          "id",
                          "label",
                          "kind",
                          "outcome"
                        ]
                      }
                    ]
                  }
                }
              },
              "required": [
                "text"
              ]
            }
          }
        },
        "required": [
          "id",
          "title",
          "stages"
        ]
      }
    }
  },
  "required": [
    "kind",
    "source",
    "entries"
  ],
  "$defs": {
    "__schema0": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "__schema1": {
      "type": "number",
      "minimum": 0
    },
    "__schema2": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "__schema3": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/__schema0"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "const": "table"
              },
              "table": {
                "description": "A parts table id",
                "$ref": "#/$defs/__schema0"
              }
            },
            "required": [
              "from",
              "table"
            ]
          },
          {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "const": "creature"
              },
              "types": {
                "default": [],
                "description": "Empty means any type",
                "$ref": "#/$defs/__schema4"
              },
              "maxCr": {
                "type": "number",
                "minimum": 0
              },
              "form": {
                "default": "group",
                "type": "string",
                "enum": [
                  "group",
                  "name"
                ]
              }
            },
            "required": [
              "from"
            ]
          }
        ]
      }
    },
    "__schema4": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "aberration",
          "beast",
          "celestial",
          "construct",
          "dragon",
          "elemental",
          "fey",
          "fiend",
          "giant",
          "humanoid",
          "monstrosity",
          "ooze",
          "plant",
          "undead"
        ]
      }
    },
    "__schema5": {
      "type": "boolean"
    },
    "__schema6": {
      "type": "boolean"
    },
    "__schema7": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "dc": {
          "default": 13,
          "description": "What \"dc\" means in the archetype",
          "$ref": "#/$defs/__schema8"
        },
        "reward": {
          "default": 1,
          "description": "Multiplies every gold amount in the archetype",
          "$ref": "#/$defs/__schema9"
        }
      },
      "required": [
        "id"
      ]
    },
    "__schema8": {
      "type": "integer",
      "minimum": 1,
      "maximum": 40
    },
    "__schema9": {
      "type": "number",
      "minimum": 0,
      "maximum": 10
    },
    "__schema10": {
      "description": "Unique within its stage",
      "$ref": "#/$defs/__schema0"
    },
    "__schema11": {
      "type": "string"
    },
    "__schema12": {
      "type": "string"
    },
    "__schema13": {
      "default": [],
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "req": {
                "type": "string",
                "const": "gold"
              },
              "min": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "req",
              "min"
            ]
          }
        ]
      }
    },
    "__schema14": {
      "description": "Can only be chosen once per encounter",
      "$ref": "#/$defs/__schema15"
    },
    "__schema15": {
      "type": "boolean"
    },
    "__schema16": {
      "type": "string",
      "enum": [
        "str",
        "dex",
        "con",
        "int",
        "wis",
        "cha"
      ]
    },
    "__schema17": {
      "type": "integer",
      "minimum": 1,
      "maximum": 40
    },
    "__schema18": {
      "type": "string",
      "pattern": "^dc([+-][0-9]+)?$"
    },
    "__schema19": {
      "type": "boolean"
    },
    "__schema20": {
      "type": "boolean"
    },
    "__schema21": {
      "type": "object",
      "properties": {
        "text": {
          "$ref": "#/$defs/__schema22"
        },
        "effects": {
          "$ref": "#/$defs/__schema23"
        },
        "goto": {
          "$ref": "#/$defs/__schema39"
        },
        "stay": {
          "$ref": "#/$defs/__schema40"
        },
        "twist": {
          "description": "Replaces this outcome when the hidden twist is true",
          "$ref": "#/$defs/__schema42"
        }
      },
      "required": [
        "text"
      ]
    },
    "__schema22": {
      "type": "string"
    },
    "__schema23": {
      "default": [],
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "effect": {
                "$ref": "#/$defs/__schema24"
              },
              "amount": {
                "$ref": "#/$defs/__schema25"
              }
            },
            "required": [
              "effect",
              "amount"
            ],
            "description": "Gain or lose gold; gold never drops below 0"
          },
          {
            "type": "object",
            "properties": {
              "effect": {
                "$ref": "#/$defs/__schema26"
              },
              "amount": {
                "$ref": "#/$defs/__schema25"
              },
              "target": {
                "$ref": "#/$defs/__schema27"
              }
            },
            "required": [
              "effect",
              "amount",
              "target"
            ],
            "description": "Heal (+) or hurt (−) the acting member, everyone, or one random conscious member"
          },
          {
            "type": "object",
            "properties": {
              "effect": {
                "$ref": "#/$defs/__schema28"
              },
              "amount": {
                "$ref": "#/$defs/__schema25"
              },
              "target": {
                "$ref": "#/$defs/__schema29"
              }
            },
            "required": [
              "effect",
              "amount",
              "target"
            ],
            "description": "Add (+) or remove (−) exhaustion levels"
          },
          {
            "type": "object",
            "properties": {
              "effect": {
                "type": "string",
                "const": "inspiration"
              },
              "amount": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "effect",
              "amount"
            ]
          },
          {
            "type": "object",
            "properties": {
              "effect": {
                "$ref": "#/$defs/__schema30"
              },
              "amount": {
                "$ref": "#/$defs/__schema31"
              }
            },
            "required": [
              "effect",
              "amount"
            ],
            "description": "Time passes"
          },
          {
            "type": "object",
            "properties": {
              "effect": {
                "$ref": "#/$defs/__schema32"
              },
              "position": {
                "$ref": "#/$defs/__schema33"
              }
            },
            "required": [
              "effect",
              "position"
            ],
            "description": "Edge or Exposed for the next check in this encounter"
          },
          {
            "type": "object",
            "properties": {
              "effect": {
                "$ref": "#/$defs/__schema34"
              },
              "situation": {
                "$ref": "#/$defs/__schema0"
              },
              "after": {
                "$ref": "#/$defs/__schema35"
              }
            },
            "required": [
              "effect",
              "situation"
            ],
            "description": "Queue a later encounter"
          },
          {
            "type": "object",
            "properties": {
              "effect": {
                "$ref": "#/$defs/__schema37"
              },
              "amount": {
                "$ref": "#/$defs/__schema25"
              }
            },
            "required": [
              "effect",
              "amount"
            ],
            "description": "Add to the party's next check in this encounter (e.g. −2 after misreading a situation)"
          },
          {
            "type": "object",
            "properties": {
              "effect": {
                "$ref": "#/$defs/__schema38"
              }
            },
            "required": [
              "effect"
            ],
            "description": "Show the odds of the hidden twist"
          },
          {
            "type": "object",
            "properties": {
              "effect": {
                "type": "string",
                "const": "log"
              },
              "text": {
                "type": "string"
              },
              "tone": {
                "default": "info",
                "type": "string",
                "enum": [
                  "info",
                  "good",
                  "bad",
                  "crit"
                ]
              }
            },
            "required": [
              "effect",
              "text"
            ]
          }
        ]
      }
    },
    "__schema24": {
      "type": "string",
      "const": "gold"
    },
    "__schema25": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "__schema26": {
      "type": "string",
      "const": "hp"
    },
    "__schema27": {
      "type": "string",
      "enum": [
        "actor",
        "all",
        "random"
      ]
    },
    "__schema28": {
      "type": "string",
      "const": "exhaustion"
    },
    "__schema29": {
      "type": "string",
      "enum": [
        "actor",
        "all"
      ]
    },
    "__schema30": {
      "type": "string",
      "const": "days"
    },
    "__schema31": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "__schema32": {
      "type": "string",
      "const": "position"
    },
    "__schema33": {
      "type": "string",
      "enum": [
        "normal",
        "edge",
        "exposed"
      ]
    },
    "__schema34": {
      "type": "string",
      "const": "followUp"
    },
    "__schema35": {
      "default": 0,
      "description": "Other encounters that happen first",
      "$ref": "#/$defs/__schema36"
    },
    "__schema36": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema37": {
      "type": "string",
      "const": "nextCheckModifier"
    },
    "__schema38": {
      "type": "string",
      "const": "revealTwist"
    },
    "__schema39": {
      "description": "Next stage. Without goto or stay, the encounter ends.",
      "$ref": "#/$defs/__schema0"
    },
    "__schema40": {
      "description": "Stay on the current stage",
      "$ref": "#/$defs/__schema41"
    },
    "__schema41": {
      "type": "boolean"
    },
    "__schema42": {
      "type": "object",
      "properties": {
        "text": {
          "$ref": "#/$defs/__schema22"
        },
        "effects": {
          "$ref": "#/$defs/__schema23"
        },
        "goto": {
          "$ref": "#/$defs/__schema39"
        },
        "stay": {
          "$ref": "#/$defs/__schema40"
        }
      },
      "required": [
        "text"
      ]
    }
  }
}
