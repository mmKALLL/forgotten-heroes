        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "$ref": "#/$defs/__schema48"
            },
            "skill": {
              "$ref": "#/$defs/__schema49"
            },
            "if": {
              "$ref": "#/$defs/__schema14"
            }
          },
          "required": [
            "effect",
            "skill"
          ],
          "description": "Make the best-suited member who lacks the skill proficient in it (ties: party order)"
        },
        {
          "type": "object",
