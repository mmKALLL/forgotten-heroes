{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "const": "situations"
    },
    "source": {
      "type": "string",
      "enum": [
        "original",
        "imported",
        "imported-private",
        "procedural",
        "claude"
      ]
    },
    "notes": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/__schema0"
          },
          "title": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "weight": {
            "default": 1,
            "description": "Relative chance in a random draw",
            "$ref": "#/$defs/__schema1"
          },
          "tags": {
            "default": [],
            "description": "Biomes and themes, for later plans",
            "$ref": "#/$defs/__schema2"
          },
          "slots": {
            "default": {},
            "description": "Filled when the encounter starts",
            "$ref": "#/$defs/__schema3"
          },
          "twist": {
            "type": "object",
            "properties": {
              "chance": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Rolled secretly when the encounter starts"
              },
              "what": {
                "type": "string",
                "description": "Always shown, e.g. \"they are bait for an ambush\"; Insight reveals the chance. With the twist table keep it vague (\"they are not what they seem\"): the kind stays hidden."
              },
              "table": {
                "default": false,
                "description": "Draw the twist kind from the twist table (data/procedural) when the encounter starts. Its stages join the situation, and \"@twist\" goes to them.",
                "$ref": "#/$defs/__schema5"
              },
              "kinds": {
                "description": "With the table: only these twist kinds can be drawn",
                "$ref": "#/$defs/__schema6"
              },
              "stage": {
                "description": "A bespoke twist's escalation stage: where \"@twist\" goes. Set by the engine for table twists.",
                "$ref": "#/$defs/__schema0"
              },
              "opening": {
                "default": [],
                "description": "A bespoke twist's opening hit, applied by { \"effect\": \"openingHit\" }. Set by the engine for table twists.",
                "$ref": "#/$defs/__schema7"
              }
            },
            "required": [
              "chance",
              "what"
            ]
          },
          "wonder": {
            "default": false,
            "description": "One click, flavour only, never a cost",
            "$ref": "#/$defs/__schema35"
          },
          "followUpOnly": {
            "default": false,
            "description": "Never drawn at random; only queued by followUp",
            "$ref": "#/$defs/__schema36"
          },
          "start": {
            "default": "start",
            "$ref": "#/$defs/__schema0"
          },
          "stages": {
            "type": "object",
            "propertyNames": {
              "$ref": "#/$defs/__schema0"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string"
                },
                "archetype": {
                  "description": "Its options come first, then this stage's own",
                  "$ref": "#/$defs/__schema37"
                },
                "options": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "id": {
                            "$ref": "#/$defs/__schema40"
                          },
                          "label": {
                            "$ref": "#/$defs/__schema41"
                          },
                          "description": {
                            "$ref": "#/$defs/__schema42"
                          },
                          "requires": {
                            "$ref": "#/$defs/__schema43"
                          },
                          "once": {
                            "$ref": "#/$defs/__schema44"
                          },
                          "kind": {
                            "type": "string",
                            "const": "check"
                          },
                          "check": {
                            "type": "object",
                            "properties": {
                              "skill": {
                                "type": "string",
                                "enum": [
                                  "acrobatics",
                                  "animalHandling",
                                  "arcana",
                                  "athletics",
                                  "deception",
                                  "history",
                                  "insight",
                                  "intimidation",
                                  "investigation",
                                  "medicine",
                                  "nature",
                                  "perception",
                                  "performance",
                                  "persuasion",
                                  "religion",
                                  "sleightOfHand",
                                  "stealth",
                                  "survival"
                                ]
                              },
                              "ability": {
                                "description": "Overrides the skill's default ability, e.g. \"cha\" for Intimidation (CHA)",
                                "$ref": "#/$defs/__schema46"
                              },
                              "dc": {
                                "anyOf": [
                                  {
                                    "$ref": "#/$defs/__schema47"
                                  },
                                  {
                                    "$ref": "#/$defs/__schema48"
                                  }
                                ],
                                "description": "A DC from 1 to 40, or inside an archetype \"dc\", \"dc+2\" or \"dc-1\""
                              },
                              "combat": {
                                "description": "Combat checks never grant Inspiration on a natural 20",
                                "$ref": "#/$defs/__schema49"
                              }
                            },
                            "required": [
                              "skill",
                              "dc"
                            ]
                          },
                          "highStakes": {
                            "description": "Force the slow, glowing dice roll",
                            "$ref": "#/$defs/__schema50"
                          },
                          "outcomes": {
                            "type": "object",
                            "properties": {
                              "critFail": {
                                "description": "Defaults to the fail outcome",
                                "$ref": "#/$defs/__schema51"
                              },
                              "fail": {
                                "$ref": "#/$defs/__schema51"
                              },
                              "partial": {
                                "$ref": "#/$defs/__schema51"
                              },
                              "success": {
                                "$ref": "#/$defs/__schema51"
                              },
                              "critSuccess": {
                                "description": "Defaults to the success outcome",
                                "$ref": "#/$defs/__schema51"
                              }
                            },
                            "required": [
                              "fail",
                              "partial",
                              "success"
                            ]
                          }
                        },
                        "required": [
                          "id",
                          "label",
                          "kind",
                          "check",
                          "outcomes"
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "id": {
                            "$ref": "#/$defs/__schema40"
                          },
                          "label": {
                            "$ref": "#/$defs/__schema41"
                          },
                          "description": {
                            "$ref": "#/$defs/__schema42"
                          },
                          "requires": {
                            "$ref": "#/$defs/__schema43"
                          },
                          "once": {
                            "$ref": "#/$defs/__schema44"
                          },
                          "kind": {
                            "type": "string",
                            "const": "fixed"
                          },
                          "outcome": {
                            "$ref": "#/$defs/__schema51"
                          }
                        },
                        "required": [
                          "id",
                          "label",
                          "kind",
                          "outcome"
                        ]
                      }
                    ]
                  }
                }
              },
              "required": [
                "text"
              ]
            }
          }
        },
        "required": [
          "id",
          "title",
          "stages"
        ]
      }
    }
  },
  "required": [
    "kind",
    "source",
    "entries"
  ],
  "$defs": {
    "__schema0": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "__schema1": {
      "type": "number",
      "minimum": 0
    },
    "__schema2": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "__schema3": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/__schema0"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "const": "table"
              },
              "table": {
                "description": "A parts table id",
                "$ref": "#/$defs/__schema0"
              }
            },
            "required": [
              "from",
              "table"
            ]
          },
          {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "const": "creature"
              },
              "types": {
                "default": [],
                "description": "Empty means any type",
                "$ref": "#/$defs/__schema4"
              },
              "maxCr": {
                "type": "number",
                "minimum": 0
              },
              "form": {
                "default": "group",
                "type": "string",
                "enum": [
                  "group",
                  "name"
                ]
              }
            },
            "required": [
              "from"
            ]
          }
        ]
      }
    },
    "__schema4": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "aberration",
          "beast",
          "celestial",
          "construct",
          "dragon",
          "elemental",
          "fey",
          "fiend",
          "giant",
          "humanoid",
          "monstrosity",
          "ooze",
          "plant",
          "undead"
        ]
      }
    },
    "__schema5": {
      "type": "boolean"
    },
    "__schema6": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "__schema7": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema8"
      }
    },
    "__schema8": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "effect": {
              "$ref": "#/$defs/__schema9"
            },
            "amount": {
              "$ref": "#/$defs/__schema10"
            },
            "if": {
              "$ref": "#/$defs/__schema11"
            }
          },
          "required": [
            "effect",
            "amount"
          ],
          "description": "Gain or lose gold; gold never drops below 0"
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "$ref": "#/$defs/__schema16"
            },
            "amount": {
              "$ref": "#/$defs/__schema10"
            },
            "target": {
              "$ref": "#/$defs/__schema17"
            },
            "if": {
              "$ref": "#/$defs/__schema11"
            }
          },
          "required": [
            "effect",
            "amount",
            "target"
          ],
          "description": "Heal (+) or hurt (−) the acting member, everyone, or one random member who can still act"
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "$ref": "#/$defs/__schema18"
            },
            "amount": {
              "$ref": "#/$defs/__schema10"
            },
            "target": {
              "$ref": "#/$defs/__schema19"
            },
            "if": {
              "$ref": "#/$defs/__schema11"
            }
          },
          "required": [
            "effect",
            "amount",
            "target"
          ],
          "description": "Add (+) or remove (−) exhaustion levels"
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "$ref": "#/$defs/__schema20"
            },
            "amount": {
              "$ref": "#/$defs/__schema10"
            },
            "if": {
              "$ref": "#/$defs/__schema11"
            }
          },
          "required": [
            "effect",
            "amount"
          ],
          "description": "Gain (+) or lose (−) Inspiration; it never drops below 0"
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "$ref": "#/$defs/__schema21"
            },
            "amount": {
              "$ref": "#/$defs/__schema22"
            },
            "if": {
              "$ref": "#/$defs/__schema11"
            }
          },
          "required": [
            "effect",
            "amount"
          ],
          "description": "Time passes"
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "$ref": "#/$defs/__schema23"
            },
            "position": {
              "$ref": "#/$defs/__schema24"
            },
            "if": {
              "$ref": "#/$defs/__schema11"
            }
          },
          "required": [
            "effect",
            "position"
          ],
          "description": "Edge or Exposed for the next check in this encounter"
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "$ref": "#/$defs/__schema25"
            },
            "situation": {
              "$ref": "#/$defs/__schema0"
            },
            "after": {
              "$ref": "#/$defs/__schema26"
            },
            "if": {
              "$ref": "#/$defs/__schema11"
            }
          },
          "required": [
            "effect",
            "situation"
          ],
          "description": "Queue a later encounter"
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "$ref": "#/$defs/__schema28"
            },
            "amount": {
              "$ref": "#/$defs/__schema10"
            },
            "reason": {
              "$ref": "#/$defs/__schema29"
            },
            "if": {
              "$ref": "#/$defs/__schema11"
            }
          },
          "required": [
            "effect",
            "amount"
          ],
          "description": "Add to the party's next check in this encounter (e.g. −2 after misreading a situation)"
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "$ref": "#/$defs/__schema31"
            },
            "kind": {
              "$ref": "#/$defs/__schema32"
            },
            "if": {
              "$ref": "#/$defs/__schema11"
            }
          },
          "required": [
            "effect"
          ],
          "description": "Show the odds of the hidden twist"
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "$ref": "#/$defs/__schema34"
            },
            "if": {
              "$ref": "#/$defs/__schema11"
            }
          },
          "required": [
            "effect"
          ],
          "description": "The twist's opening hit: the drawn twist kind's opening effects, or a bespoke twist's `opening`. Only in twist branches."
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "type": "string",
              "const": "log"
            },
            "text": {
              "type": "string"
            },
            "tone": {
              "default": "info",
              "type": "string",
              "enum": [
                "info",
                "good",
                "bad",
                "crit"
              ]
            },
            "if": {
              "$ref": "#/$defs/__schema11"
            }
          },
          "required": [
            "effect",
            "text"
          ]
        }
      ]
    },
    "__schema9": {
      "type": "string",
      "const": "gold"
    },
    "__schema10": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "__schema11": {
      "description": "Only applies when this holds",
      "$ref": "#/$defs/__schema12"
    },
    "__schema12": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "cond": {
              "$ref": "#/$defs/__schema13"
            },
            "not": {
              "$ref": "#/$defs/__schema14"
            }
          },
          "required": [
            "cond"
          ],
          "description": "The twist's odds have been revealed earlier in the encounter (e.g. by Insight)"
        }
      ]
    },
    "__schema13": {
      "type": "string",
      "const": "twistRevealed"
    },
    "__schema14": {
      "description": "True: only when the odds are still hidden",
      "$ref": "#/$defs/__schema15"
    },
    "__schema15": {
      "type": "boolean"
    },
    "__schema16": {
      "type": "string",
      "const": "hp"
    },
    "__schema17": {
      "type": "string",
      "enum": [
        "actor",
        "all",
        "random"
      ]
    },
    "__schema18": {
      "type": "string",
      "const": "exhaustion"
    },
    "__schema19": {
      "type": "string",
      "enum": [
        "actor",
        "all"
      ]
    },
    "__schema20": {
      "type": "string",
      "const": "inspiration"
    },
    "__schema21": {
      "type": "string",
      "const": "days"
    },
    "__schema22": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "__schema23": {
      "type": "string",
      "const": "position"
    },
    "__schema24": {
      "type": "string",
      "enum": [
        "normal",
        "edge",
        "exposed"
      ]
    },
    "__schema25": {
      "type": "string",
      "const": "followUp"
    },
    "__schema26": {
      "default": 0,
      "description": "Other encounters that happen first",
      "$ref": "#/$defs/__schema27"
    },
    "__schema27": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema28": {
      "type": "string",
      "const": "nextCheckModifier"
    },
    "__schema29": {
      "description": "Shown next to the modifier, e.g. \"misread\"",
      "$ref": "#/$defs/__schema30"
    },
    "__schema30": {
      "type": "string"
    },
    "__schema31": {
      "type": "string",
      "const": "revealTwist"
    },
    "__schema32": {
      "description": "Also reveal which kind of twist it would be (twist-table twists)",
      "$ref": "#/$defs/__schema33"
    },
    "__schema33": {
      "type": "boolean"
    },
    "__schema34": {
      "type": "string",
      "const": "openingHit"
    },
    "__schema35": {
      "type": "boolean"
    },
    "__schema36": {
      "type": "boolean"
    },
    "__schema37": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "dc": {
          "default": 13,
          "description": "What \"dc\" means in the archetype",
          "$ref": "#/$defs/__schema38"
        },
        "reward": {
          "default": 1,
          "description": "Multiplies every gold amount in the archetype",
          "$ref": "#/$defs/__schema39"
        }
      },
      "required": [
        "id"
      ]
    },
    "__schema38": {
      "type": "integer",
      "minimum": 1,
      "maximum": 40
    },
    "__schema39": {
      "type": "number",
      "minimum": 0,
      "maximum": 10
    },
    "__schema40": {
      "description": "Unique within its stage",
      "$ref": "#/$defs/__schema0"
    },
    "__schema41": {
      "type": "string"
    },
    "__schema42": {
      "type": "string"
    },
    "__schema43": {
      "default": [],
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "req": {
                "type": "string",
                "const": "gold"
              },
              "min": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "req",
              "min"
            ]
          }
        ]
      }
    },
    "__schema44": {
      "description": "Can only be chosen once per encounter",
      "$ref": "#/$defs/__schema45"
    },
    "__schema45": {
      "type": "boolean"
    },
    "__schema46": {
      "type": "string",
      "enum": [
        "str",
        "dex",
        "con",
        "int",
        "wis",
        "cha"
      ]
    },
    "__schema47": {
      "type": "integer",
      "minimum": 1,
      "maximum": 40
    },
    "__schema48": {
      "type": "string",
      "pattern": "^dc([+-][0-9]+)?$"
    },
    "__schema49": {
      "type": "boolean"
    },
    "__schema50": {
      "type": "boolean"
    },
    "__schema51": {
      "type": "object",
      "properties": {
        "text": {
          "$ref": "#/$defs/__schema52"
        },
        "effects": {
          "$ref": "#/$defs/__schema53"
        },
        "goto": {
          "$ref": "#/$defs/__schema54"
        },
        "stay": {
          "$ref": "#/$defs/__schema56"
        },
        "twist": {
          "description": "Replaces this outcome when the hidden twist is true",
          "$ref": "#/$defs/__schema58"
        }
      },
      "required": [
        "text"
      ]
    },
    "__schema52": {
      "type": "string"
    },
    "__schema53": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema8"
      }
    },
    "__schema54": {
      "description": "Next stage. \"@twist\" (only in twist branches) goes to the twist's escalation stage. Without goto or stay, the encounter ends.",
      "$ref": "#/$defs/__schema55"
    },
    "__schema55": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema0"
        },
        {
          "type": "string",
          "const": "@twist"
        }
      ]
    },
    "__schema56": {
      "description": "Stay on the current stage",
      "$ref": "#/$defs/__schema57"
    },
    "__schema57": {
      "type": "boolean"
    },
    "__schema58": {
      "type": "object",
      "properties": {
        "text": {
          "$ref": "#/$defs/__schema52"
        },
        "effects": {
          "$ref": "#/$defs/__schema53"
        },
        "goto": {
          "$ref": "#/$defs/__schema54"
        },
        "stay": {
          "$ref": "#/$defs/__schema56"
        }
      },
      "required": [
        "text"
      ]
    }
  }
}
