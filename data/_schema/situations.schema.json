              "$ref": "#/$defs/__schema64"
            },
            "amount": {
              "$ref": "#/$defs/__schema13"
            },
            "if": {
              "$ref": "#/$defs/__schema14"
            }
          },
          "required": [
            "effect",
            "amount"
          ],
