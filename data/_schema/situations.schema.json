          "properties": {
            "effect": {
              "$ref": "#/$defs/__schema62"
            },
            "amount": {
              "$ref": "#/$defs/__schema63"
            },
            "if": {
              "$ref": "#/$defs/__schema14"
            }
          },
          "required": [
            "effect",
            "amount"
          ],
