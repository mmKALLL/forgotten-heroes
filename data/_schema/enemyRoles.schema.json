{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "const": "enemyRoles"
    },
    "source": {
      "type": "string",
      "enum": [
        "original",
        "imported",
        "imported-private",
        "procedural",
        "claude"
      ]
    },
    "notes": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "brute",
              "skirmisher",
              "archer",
              "caster",
              "swarm",
              "leader"
            ]
          },
          "name": {
            "type": "string"
          },
          "favoured": {
            "description": "The distance it tries to keep from the nearest member",
            "$ref": "#/$defs/__schema2"
          },
          "reach": {
            "description": "The distances its attack reaches",
            "$ref": "#/$defs/__schema2"
          },
          "stats": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema3"
            },
            "description": "By rising CR: a creature takes the last row at or below its CR"
          }
        },
        "required": [
          "id",
          "name",
          "favoured",
          "reach",
          "stats"
        ]
      }
    }
  },
  "required": [
    "kind",
    "source",
    "entries"
  ],
  "$defs": {
    "__schema0": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8
    },
    "__schema1": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8
    },
    "__schema2": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/__schema0"
        },
        {
          "$ref": "#/$defs/__schema1"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "__schema3": {
      "type": "object",
      "properties": {
        "cr": {
          "type": "number",
          "minimum": 0
        },
        "hp": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "ac": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "toHit": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "damage": {
          "type": "object",
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "die": {
              "anyOf": [
                {
                  "type": "number",
                  "const": 4
                },
                {
                  "type": "number",
                  "const": 6
                },
                {
                  "type": "number",
                  "const": 8
                },
                {
                  "type": "number",
                  "const": 10
                },
                {
                  "type": "number",
                  "const": 12
                }
              ]
            },
            "bonus": {
              "default": 0,
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "count",
            "die"
          ]
        },
        "wis": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "Its WIS save modifier (morale)"
        }
      },
      "required": [
        "cr",
        "hp",
        "ac",
        "toHit",
        "damage",
        "wis"
      ]
    }
  }
}
