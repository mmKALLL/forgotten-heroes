{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "const": "situationTemplates"
    },
    "source": {
      "type": "string",
      "enum": [
        "original",
        "imported",
        "imported-private",
        "procedural",
        "claude"
      ]
    },
    "notes": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/__schema0"
          },
          "title": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "weight": {
            "default": 1,
            "description": "Relative chance in a random draw",
            "$ref": "#/$defs/__schema1"
          },
          "tags": {
            "default": [],
            "description": "Themes, e.g. \"road\"; biomes and regions filter where it happens",
            "$ref": "#/$defs/__schema2"
          },
          "biomes": {
            "description": "Only drawn on the road in these terrains; omit for anywhere on land. \"sea\" for ships.",
            "$ref": "#/$defs/__schema3"
          },
          "regions": {
            "description": "Only drawn on the road in these regions; omit for anywhere",
            "$ref": "#/$defs/__schema4"
          },
          "disposition": {
            "description": "How it treats the party. A cautious party avoids some hostile encounters and meets the rest on better footing. Required (by the lint) unless followUpOnly; wonders are never hostile.",
            "$ref": "#/$defs/__schema5"
          },
          "slots": {
            "default": {},
            "description": "Filled when the encounter starts",
            "$ref": "#/$defs/__schema6"
          },
          "twist": {
            "type": "object",
            "properties": {
              "chance": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Rolled secretly when the encounter starts"
              },
              "what": {
                "type": "string",
                "description": "Always shown, e.g. \"they are bait for an ambush\"; Insight reveals the chance. With the twist table keep it vague (\"they are not what they seem\"): the kind stays hidden."
              },
              "table": {
                "default": false,
                "description": "Draw the twist kind from the twist table (data/procedural) when the encounter starts. Its stages join the situation, and \"@twist\" goes to them.",
                "$ref": "#/$defs/__schema8"
              },
              "kinds": {
                "description": "With the table: only these twist kinds can be drawn",
                "$ref": "#/$defs/__schema9"
              },
              "stage": {
                "description": "A bespoke twist's escalation stage: where \"@twist\" goes. Set by the engine for table twists.",
                "$ref": "#/$defs/__schema0"
              },
              "opening": {
                "default": [],
                "description": "A bespoke twist's opening hit, applied by { \"effect\": \"openingHit\" }. Set by the engine for table twists.",
                "$ref": "#/$defs/__schema10"
              }
            },
            "required": [
              "chance",
              "what"
            ]
          },
          "text": {
            "type": "string"
          },
          "archetype": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/__schema0"
              },
              "dc": {
                "default": 13,
                "description": "What \"dc\" means in the archetype",
                "$ref": "#/$defs/__schema46"
              },
              "reward": {
                "default": 1,
                "description": "Multiplies every gold amount in the archetype",
                "$ref": "#/$defs/__schema47"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "text",
          "archetype"
        ]
      }
    }
  },
  "required": [
    "kind",
    "source",
    "entries"
  ],
  "$defs": {
    "__schema0": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "__schema1": {
      "type": "number",
      "minimum": 0
    },
    "__schema2": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "__schema3": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "plains",
          "forest",
          "hills",
          "mountains",
          "marsh",
          "desert",
          "jungle",
          "sea"
        ]
      }
    },
    "__schema4": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "__schema5": {
      "type": "string",
      "enum": [
        "hostile",
        "neutral",
        "pleasant"
      ]
    },
    "__schema6": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/__schema0"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "const": "table"
              },
              "table": {
                "description": "A parts table id",
                "$ref": "#/$defs/__schema0"
              }
            },
            "required": [
              "from",
              "table"
            ]
          },
          {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "const": "creature"
              },
              "types": {
                "default": [],
                "description": "Empty means any type",
                "$ref": "#/$defs/__schema7"
              },
              "maxCr": {
                "type": "number",
                "minimum": 0
              },
              "form": {
                "default": "group",
                "type": "string",
                "enum": [
                  "group",
                  "name"
                ]
              }
            },
            "required": [
              "from"
            ]
          }
        ]
      }
    },
    "__schema7": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "aberration",
          "beast",
          "celestial",
          "construct",
          "dragon",
          "elemental",
          "fey",
          "fiend",
          "giant",
          "humanoid",
          "monstrosity",
          "ooze",
          "plant",
          "undead"
        ]
      }
    },
    "__schema8": {
      "type": "boolean"
    },
    "__schema9": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "__schema10": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "effect": {
                "$ref": "#/$defs/__schema11"
              },
              "amount": {
                "$ref": "#/$defs/__schema12"
              },
              "if": {
                "$ref": "#/$defs/__schema13"
              }
            },
            "required": [
              "effect",
              "amount"
            ],
            "description": "Gain or lose gold; gold never drops below 0"
          },
          {
            "type": "object",
            "properties": {
              "effect": {
                "$ref": "#/$defs/__schema18"
              },
              "amount": {
                "$ref": "#/$defs/__schema12"
              },
              "target": {
                "$ref": "#/$defs/__schema19"
              },
              "if": {
                "$ref": "#/$defs/__schema13"
              }
            },
            "required": [
              "effect",
              "amount",
              "target"
            ],
            "description": "Heal (+) or hurt (−) the acting member, everyone, or one random member who can still act"
          },
          {
            "type": "object",
            "properties": {
              "effect": {
                "$ref": "#/$defs/__schema20"
              },
              "amount": {
                "$ref": "#/$defs/__schema12"
              },
              "target": {
                "$ref": "#/$defs/__schema21"
              },
              "if": {
                "$ref": "#/$defs/__schema13"
              }
            },
            "required": [
              "effect",
              "amount",
              "target"
            ],
            "description": "Add (+) or remove (−) exhaustion levels"
          },
          {
            "type": "object",
            "properties": {
              "effect": {
                "$ref": "#/$defs/__schema22"
              },
              "amount": {
                "$ref": "#/$defs/__schema12"
              },
              "if": {
                "$ref": "#/$defs/__schema13"
              }
            },
            "required": [
              "effect",
              "amount"
            ],
            "description": "Gain (+) or lose (−) Inspiration; it never drops below 0"
          },
          {
            "type": "object",
            "properties": {
              "effect": {
                "$ref": "#/$defs/__schema23"
              },
              "amount": {
                "$ref": "#/$defs/__schema24"
              },
              "if": {
                "$ref": "#/$defs/__schema13"
              }
            },
            "required": [
              "effect",
              "amount"
            ],
            "description": "Time passes: each day everyone eats and drinks from the supplies, or goes without"
          },
          {
            "type": "object",
            "properties": {
              "effect": {
                "$ref": "#/$defs/__schema25"
              },
              "position": {
                "$ref": "#/$defs/__schema26"
              },
              "if": {
                "$ref": "#/$defs/__schema13"
              }
            },
            "required": [
              "effect",
              "position"
            ],
            "description": "Edge or Exposed for the next check in this encounter"
          },
          {
            "type": "object",
            "properties": {
              "effect": {
                "$ref": "#/$defs/__schema27"
              },
              "situation": {
                "$ref": "#/$defs/__schema0"
              },
              "after": {
                "$ref": "#/$defs/__schema28"
              },
              "if": {
                "$ref": "#/$defs/__schema13"
              }
            },
            "required": [
              "effect",
              "situation"
            ],
            "description": "Queue a later encounter"
          },
          {
            "type": "object",
            "properties": {
              "effect": {
                "$ref": "#/$defs/__schema30"
              },
              "amount": {
                "$ref": "#/$defs/__schema12"
              },
              "reason": {
                "$ref": "#/$defs/__schema31"
              },
              "if": {
                "$ref": "#/$defs/__schema13"
              }
            },
            "required": [
              "effect",
              "amount"
            ],
            "description": "Add to the party's next check in this encounter (e.g. −2 after misreading a situation)"
          },
          {
            "type": "object",
            "properties": {
              "effect": {
                "$ref": "#/$defs/__schema33"
              },
              "kind": {
                "$ref": "#/$defs/__schema34"
              },
              "if": {
                "$ref": "#/$defs/__schema13"
              }
            },
            "required": [
              "effect"
            ],
            "description": "Show the odds of the hidden twist"
          },
          {
            "type": "object",
            "properties": {
              "effect": {
                "$ref": "#/$defs/__schema36"
              },
              "if": {
                "$ref": "#/$defs/__schema13"
              }
            },
            "required": [
              "effect"
            ],
            "description": "The twist's opening hit: the drawn twist kind's opening effects, or a bespoke twist's `opening`. Only in twist branches."
          },
          {
            "type": "object",
            "properties": {
              "effect": {
                "type": "string",
                "const": "log"
              },
              "text": {
                "type": "string"
              },
              "tone": {
                "default": "info",
                "type": "string",
                "enum": [
                  "info",
                  "good",
                  "bad",
                  "crit"
                ]
              },
              "if": {
                "$ref": "#/$defs/__schema13"
              }
            },
            "required": [
              "effect",
              "text"
            ]
          },
          {
            "type": "object",
            "properties": {
              "effect": {
                "$ref": "#/$defs/__schema37"
              },
              "count": {
                "$ref": "#/$defs/__schema38"
              },
              "scope": {
                "$ref": "#/$defs/__schema39"
              },
              "category": {
                "$ref": "#/$defs/__schema41"
              },
              "if": {
                "$ref": "#/$defs/__schema13"
              }
            },
            "required": [
              "effect"
            ],
            "description": "Reveal the nearest undiscovered points of interest to the encounter's domain (a clue)"
          },
          {
            "type": "object",
            "properties": {
              "effect": {
                "$ref": "#/$defs/__schema43"
              },
              "if": {
                "$ref": "#/$defs/__schema13"
              }
            },
            "required": [
              "effect"
            ],
            "description": "Clear the dungeon or lair being visited: it lies empty (and feeds no threat) until something moves in again (REINHABIT_DAYS)"
          },
          {
            "type": "object",
            "properties": {
              "effect": {
                "$ref": "#/$defs/__schema44"
              },
              "skill": {
                "$ref": "#/$defs/__schema45"
              },
              "if": {
                "$ref": "#/$defs/__schema13"
              }
            },
            "required": [
              "effect",
              "skill"
            ],
            "description": "Make the best-suited member who lacks the skill proficient in it (ties: party order)"
          }
        ]
      }
    },
    "__schema11": {
      "type": "string",
      "const": "gold"
    },
    "__schema12": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "__schema13": {
      "description": "Only applies when this holds",
      "$ref": "#/$defs/__schema14"
    },
    "__schema14": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "cond": {
              "$ref": "#/$defs/__schema15"
            },
            "not": {
              "$ref": "#/$defs/__schema16"
            }
          },
          "required": [
            "cond"
          ],
          "description": "The twist's odds have been revealed earlier in the encounter (e.g. by Insight)"
        }
      ]
    },
    "__schema15": {
      "type": "string",
      "const": "twistRevealed"
    },
    "__schema16": {
      "description": "True: only when the odds are still hidden",
      "$ref": "#/$defs/__schema17"
    },
    "__schema17": {
      "type": "boolean"
    },
    "__schema18": {
      "type": "string",
      "const": "hp"
    },
    "__schema19": {
      "type": "string",
      "enum": [
        "actor",
        "all",
        "random"
      ]
    },
    "__schema20": {
      "type": "string",
      "const": "exhaustion"
    },
    "__schema21": {
      "type": "string",
      "enum": [
        "actor",
        "all"
      ]
    },
    "__schema22": {
      "type": "string",
      "const": "inspiration"
    },
    "__schema23": {
      "type": "string",
      "const": "days"
    },
    "__schema24": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "__schema25": {
      "type": "string",
      "const": "position"
    },
    "__schema26": {
      "type": "string",
      "enum": [
        "normal",
        "edge",
        "exposed"
      ]
    },
    "__schema27": {
      "type": "string",
      "const": "followUp"
    },
    "__schema28": {
      "default": 0,
      "description": "Other encounters that happen first",
      "$ref": "#/$defs/__schema29"
    },
    "__schema29": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema30": {
      "type": "string",
      "const": "nextCheckModifier"
    },
    "__schema31": {
      "description": "Shown next to the modifier, e.g. \"misread\"",
      "$ref": "#/$defs/__schema32"
    },
    "__schema32": {
      "type": "string"
    },
    "__schema33": {
      "type": "string",
      "const": "revealTwist"
    },
    "__schema34": {
      "description": "Also reveal which kind of twist it would be (twist-table twists)",
      "$ref": "#/$defs/__schema35"
    },
    "__schema35": {
      "type": "boolean"
    },
    "__schema36": {
      "type": "string",
      "const": "openingHit"
    },
    "__schema37": {
      "type": "string",
      "const": "discoverPoi"
    },
    "__schema38": {
      "default": 1,
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "__schema39": {
      "default": "domain",
      "description": "Where to look: the encounter's domain, or every domain of its land",
      "$ref": "#/$defs/__schema40"
    },
    "__schema40": {
      "type": "string",
      "enum": [
        "domain",
        "land"
      ]
    },
    "__schema41": {
      "description": "Only sites of this category",
      "$ref": "#/$defs/__schema42"
    },
    "__schema42": {
      "type": "string",
      "enum": [
        "dungeon",
        "expert",
        "lair",
        "shrine",
        "landmark",
        "wonder",
        "quest"
      ]
    },
    "__schema43": {
      "type": "string",
      "const": "clearPoi"
    },
    "__schema44": {
      "type": "string",
      "const": "trainSkill"
    },
    "__schema45": {
      "type": "string",
      "enum": [
        "acrobatics",
        "animalHandling",
        "arcana",
        "athletics",
        "deception",
        "history",
        "insight",
        "intimidation",
        "investigation",
        "medicine",
        "nature",
        "perception",
        "performance",
        "persuasion",
        "religion",
        "sleightOfHand",
        "stealth",
        "survival"
      ]
    },
    "__schema46": {
      "type": "integer",
      "minimum": 1,
      "maximum": 40
    },
    "__schema47": {
      "type": "number",
      "minimum": 0,
      "maximum": 10
    }
  }
}
