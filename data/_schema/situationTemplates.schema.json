{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "const": "situationTemplates"
    },
    "source": {
      "type": "string",
      "enum": [
        "original",
        "imported",
        "imported-private",
        "procedural",
        "claude"
      ]
    },
    "notes": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/__schema0"
          },
          "title": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "weight": {
            "default": 1,
            "description": "Relative chance in a random draw",
            "$ref": "#/$defs/__schema1"
          },
          "tags": {
            "default": [],
            "description": "Biomes and themes, for later plans",
            "$ref": "#/$defs/__schema2"
          },
          "slots": {
            "default": {},
            "description": "Filled when the encounter starts",
            "$ref": "#/$defs/__schema3"
          },
          "twist": {
            "type": "object",
            "properties": {
              "chance": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Rolled secretly when the encounter starts"
              },
              "what": {
                "type": "string",
                "description": "Always shown, e.g. \"they are bait for an ambush\"; Insight reveals the chance"
              }
            },
            "required": [
              "chance",
              "what"
            ]
          },
          "text": {
            "type": "string"
          },
          "archetype": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/__schema0"
              },
              "dc": {
                "default": 13,
                "description": "What \"dc\" means in the archetype",
                "$ref": "#/$defs/__schema5"
              },
              "reward": {
                "default": 1,
                "description": "Multiplies every gold amount in the archetype",
                "$ref": "#/$defs/__schema6"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "text",
          "archetype"
        ]
      }
    }
  },
  "required": [
    "kind",
    "source",
    "entries"
  ],
  "$defs": {
    "__schema0": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "__schema1": {
      "type": "number",
      "minimum": 0
    },
    "__schema2": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "__schema3": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/__schema0"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "const": "table"
              },
              "table": {
                "description": "A parts table id",
                "$ref": "#/$defs/__schema0"
              }
            },
            "required": [
              "from",
              "table"
            ]
          },
          {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "const": "creature"
              },
              "types": {
                "default": [],
                "description": "Empty means any type",
                "$ref": "#/$defs/__schema4"
              },
              "maxCr": {
                "type": "number",
                "minimum": 0
              },
              "form": {
                "default": "group",
                "type": "string",
                "enum": [
                  "group",
                  "name"
                ]
              }
            },
            "required": [
              "from"
            ]
          }
        ]
      }
    },
    "__schema4": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "aberration",
          "beast",
          "celestial",
          "construct",
          "dragon",
          "elemental",
          "fey",
          "fiend",
          "giant",
          "humanoid",
          "monstrosity",
          "ooze",
          "plant",
          "undead"
        ]
      }
    },
    "__schema5": {
      "type": "integer",
      "minimum": 1,
      "maximum": 40
    },
    "__schema6": {
      "type": "number",
      "minimum": 0,
      "maximum": 10
    }
  }
}
