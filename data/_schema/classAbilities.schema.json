{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "const": "classAbilities"
    },
    "source": {
      "type": "string",
      "enum": [
        "original",
        "imported",
        "imported-private",
        "procedural",
        "claude"
      ]
    },
    "notes": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/__schema0"
          },
          "name": {
            "type": "string"
          },
          "classId": {
            "$ref": "#/$defs/__schema0"
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "description": "The level it is gained at"
          },
          "description": {
            "type": "string"
          },
          "target": {
            "type": "string",
            "enum": [
              "self",
              "ally",
              "party",
              "enemy",
              "tile",
              "twoTiles"
            ]
          },
          "range": {
            "default": [
              0,
              0
            ],
            "description": "Tiles from the user (0: its own tile)",
            "$ref": "#/$defs/__schema1"
          },
          "effects": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema4"
            }
          },
          "action": {
            "default": "action",
            "description": "Spells and abilities take an action unless free",
            "$ref": "#/$defs/__schema6"
          },
          "roll": {
            "description": "An attack or a save; none: it always lands",
            "$ref": "#/$defs/__schema7"
          },
          "rounds": {
            "default": 1,
            "description": "How long the lasting effects last (1: this round; 10: the whole fight)",
            "$ref": "#/$defs/__schema8"
          }
        },
        "required": [
          "id",
          "name",
          "classId",
          "level",
          "description",
          "target",
          "effects"
        ]
      }
    }
  },
  "required": [
    "kind",
    "source",
    "entries"
  ],
  "$defs": {
    "__schema0": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "__schema1": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/__schema2"
        },
        {
          "$ref": "#/$defs/__schema3"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "__schema2": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8
    },
    "__schema3": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8
    },
    "__schema4": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "effect": {
              "type": "string",
              "const": "damage"
            },
            "dice": {
              "$ref": "#/$defs/__schema5"
            }
          },
          "required": [
            "effect",
            "dice"
          ]
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "type": "string",
              "const": "heal"
            },
            "dice": {
              "$ref": "#/$defs/__schema5"
            }
          },
          "required": [
            "effect",
            "dice"
          ]
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "type": "string",
              "const": "toHit"
            },
            "amount": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "effect",
            "amount"
          ]
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "type": "string",
              "const": "damageBonus"
            },
            "amount": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "effect",
            "amount"
          ]
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "type": "string",
              "const": "move"
            },
            "tiles": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            }
          },
          "required": [
            "effect",
            "tiles"
          ]
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "type": "string",
              "const": "push"
            },
            "tiles": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            }
          },
          "required": [
            "effect",
            "tiles"
          ]
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "type": "string",
              "const": "pull"
            },
            "tiles": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            }
          },
          "required": [
            "effect",
            "tiles"
          ]
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "type": "string",
              "const": "stagger"
            }
          },
          "required": [
            "effect"
          ]
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "type": "string",
              "const": "stun"
            }
          },
          "required": [
            "effect"
          ]
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "type": "string",
              "const": "extraAction"
            }
          },
          "required": [
            "effect"
          ]
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "type": "string",
              "const": "summon"
            },
            "summon": {
              "description": "The beast or celestial a good or neutral caster calls",
              "$ref": "#/$defs/__schema0"
            },
            "evil": {
              "description": "The undead an evil caster calls instead",
              "$ref": "#/$defs/__schema0"
            }
          },
          "required": [
            "effect",
            "summon"
          ]
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "type": "string",
              "const": "ac"
            },
            "amount": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "effect",
            "amount"
          ]
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "type": "string",
              "const": "tempHp"
            },
            "dice": {
              "$ref": "#/$defs/__schema5"
            }
          },
          "required": [
            "effect",
            "dice"
          ]
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "type": "string",
              "const": "ward"
            },
            "amount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "effect",
            "amount"
          ]
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "type": "string",
              "const": "vulnerable"
            },
            "amount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "effect",
            "amount"
          ]
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "type": "string",
              "const": "revive"
            },
            "dice": {
              "$ref": "#/$defs/__schema5"
            }
          },
          "required": [
            "effect",
            "dice"
          ]
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "type": "string",
              "const": "blind"
            }
          },
          "required": [
            "effect"
          ]
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "type": "string",
              "const": "slow"
            }
          },
          "required": [
            "effect"
          ]
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "type": "string",
              "const": "fear"
            }
          },
          "required": [
            "effect"
          ]
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "type": "string",
              "const": "discord"
            }
          },
          "required": [
            "effect"
          ]
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "type": "string",
              "const": "conceal"
            }
          },
          "required": [
            "effect"
          ]
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "type": "string",
              "const": "banish"
            }
          },
          "required": [
            "effect"
          ]
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "type": "string",
              "const": "wall"
            }
          },
          "required": [
            "effect"
          ]
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "type": "string",
              "const": "hazard"
            },
            "dice": {
              "$ref": "#/$defs/__schema5"
            }
          },
          "required": [
            "effect",
            "dice"
          ]
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "type": "string",
              "const": "escape"
            }
          },
          "required": [
            "effect"
          ]
        }
      ]
    },
    "__schema5": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "die": {
          "anyOf": [
            {
              "type": "number",
              "const": 4
            },
            {
              "type": "number",
              "const": 6
            },
            {
              "type": "number",
              "const": 8
            },
            {
              "type": "number",
              "const": 10
            },
            {
              "type": "number",
              "const": 12
            }
          ]
        },
        "bonus": {
          "default": 0,
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "count",
        "die"
      ]
    },
    "__schema6": {
      "type": "string",
      "enum": [
        "action",
        "free"
      ]
    },
    "__schema7": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "roll": {
              "type": "string",
              "const": "attack"
            }
          },
          "required": [
            "roll"
          ]
        },
        {
          "type": "object",
          "properties": {
            "roll": {
              "type": "string",
              "const": "save"
            },
            "ability": {
              "type": "string",
              "enum": [
                "str",
                "dex",
                "con",
                "int",
                "wis",
                "cha"
              ]
            },
            "half": {
              "default": false,
              "type": "boolean"
            }
          },
          "required": [
            "roll",
            "ability"
          ]
        }
      ]
    },
    "__schema8": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    }
  }
}
