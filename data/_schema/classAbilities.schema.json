{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "const": "classAbilities"
    },
    "source": {
      "type": "string",
      "enum": [
        "original",
        "imported",
        "imported-private",
        "procedural",
        "claude"
      ]
    },
    "notes": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/__schema0"
          },
          "name": {
            "type": "string"
          },
          "classId": {
            "$ref": "#/$defs/__schema0"
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "description": "The level it is gained at"
          },
          "description": {
            "type": "string"
          },
          "target": {
            "$ref": "#/$defs/__schema1"
          },
          "range": {
            "default": [
              0,
              0
            ],
            "description": "Tiles from the user (0: its own tile)",
            "$ref": "#/$defs/__schema2"
          },
          "effects": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema5"
            }
          },
          "action": {
            "default": "action",
            "description": "Spells and abilities take an action unless free",
            "$ref": "#/$defs/__schema11"
          },
          "roll": {
            "description": "An attack or a save; none: it always lands",
            "$ref": "#/$defs/__schema12"
          },
          "rounds": {
            "default": 1,
            "description": "How long the lasting effects last (1: this round; 10: until the fight ends)",
            "$ref": "#/$defs/__schema13"
          },
          "spends": {
            "default": "uses",
            "description": "What it spends: its own uses, or one of the user's spell uses (Smite)",
            "$ref": "#/$defs/__schema14"
          },
          "only": {
            "description": "It affects only creatures of this type (Turn Undead: \"undead\")",
            "$ref": "#/$defs/__schema15"
          },
          "specialised": {
            "description": "What a bard's specialisation pick changes (level-up choices)",
            "$ref": "#/$defs/__schema16"
          }
        },
        "required": [
          "id",
          "name",
          "classId",
          "level",
          "description",
          "target",
          "effects"
        ]
      }
    }
  },
  "required": [
    "kind",
    "source",
    "entries"
  ],
  "$defs": {
