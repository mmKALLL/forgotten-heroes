      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "__schema1": {
      "type": "string",
      "enum": [
        "self",
        "ally",
        "party",
        "enemy",
        "tile",
        "twoTiles"
      ]
