{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "const": "summons"
    },
    "source": {
      "type": "string",
      "enum": [
        "original",
        "imported",
        "imported-private",
        "procedural",
        "claude"
      ]
    },
    "notes": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "default": "",
            "type": "string"
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9,
            "description": "The spell level whose pool holds it"
          },
          "kind": {
            "type": "string",
            "enum": [
              "beast",
              "celestial",
              "undead"
            ],
            "description": "Good or neutral clerics call beasts or celestials, evil ones undead"
          },
          "role": {
            "default": "brute",
            "type": "string",
            "enum": [
              "brute",
              "skirmisher",
              "archer",
              "caster",
              "swarm",
              "leader"
            ]
          },
          "size": {
            "default": "medium",
            "type": "string",
            "enum": [
              "tiny",
              "small",
              "medium",
              "large",
              "huge",
              "gargantuan"
            ]
          },
          "hp": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "ac": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "toHit": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "damage": {
            "type": "object",
            "properties": {
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              },
              "die": {
                "anyOf": [
                  {
                    "type": "number",
                    "const": 4
                  },
                  {
                    "type": "number",
                    "const": 6
                  },
                  {
                    "type": "number",
                    "const": 8
                  },
                  {
                    "type": "number",
                    "const": 10
                  },
                  {
                    "type": "number",
                    "const": 12
                  }
                ]
              },
              "bonus": {
                "default": 0,
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "count",
              "die"
            ]
          },
          "reach": {
            "default": [
              1,
              1
            ],
            "type": "array",
            "prefixItems": [
              {
                "$ref": "#/$defs/__schema0"
              },
              {
                "$ref": "#/$defs/__schema1"
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        },
        "required": [
          "id",
          "name",
          "level",
          "kind",
          "hp",
          "ac",
          "toHit",
          "damage"
        ]
      }
    }
  },
  "required": [
    "kind",
    "source",
    "entries"
  ],
  "$defs": {
    "__schema0": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8
    },
    "__schema1": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8
    }
  }
}
