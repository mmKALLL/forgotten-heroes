{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "const": "settlementTypes"
    },
    "source": {
      "type": "string",
      "enum": [
        "original",
        "imported",
        "imported-private",
        "procedural",
        "claude"
      ]
    },
    "notes": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "lifeplace",
              "traders",
              "military",
              "other"
            ]
          },
          "minPopulation": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "maxPopulation": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "maxServices": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "ratio": {
            "type": "number",
            "minimum": 0,
            "description": "Relative frequency among settlements in a country"
          },
          "hostileChance": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "predominantAncestry": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          }
        },
        "required": [
          "id",
          "name",
          "category",
          "minPopulation",
          "maxPopulation",
          "maxServices",
          "ratio",
          "hostileChance",
          "predominantAncestry"
        ]
      }
    }
  },
  "required": [
    "kind",
    "source",
    "entries"
  ]
}
