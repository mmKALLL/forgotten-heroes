{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "const": "villains"
    },
    "source": {
      "type": "string",
      "enum": [
        "original",
        "imported",
        "imported-private",
        "procedural",
        "claude"
      ]
    },
    "notes": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/__schema0"
          },
          "name": {
            "$ref": "#/$defs/__schema1"
          },
          "names": {
            "$ref": "#/$defs/__schema2"
          },
          "weight": {
            "$ref": "#/$defs/__schema3"
          },
          "threats": {
            "$ref": "#/$defs/__schema5"
          },
          "summary": {
            "$ref": "#/$defs/__schema7"
          },
          "omen": {
            "$ref": "#/$defs/__schema8"
          },
          "plan": {
            "$ref": "#/$defs/__schema9"
          },
          "reveal": {
            "$ref": "#/$defs/__schema10"
          },
          "acts": {
            "$ref": "#/$defs/__schema11"
          },
          "victory": {
            "$ref": "#/$defs/__schema15"
          },
          "notes": {
            "$ref": "#/$defs/__schema16"
          }
        },
        "required": [
          "id",
          "name",
          "summary",
          "omen",
          "plan",
          "reveal",
          "acts",
          "victory"
        ]
      }
    }
  },
  "required": [
    "kind",
    "source",
    "entries"
  ],
  "$defs": {
    "__schema0": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "__schema1": {
      "type": "string",
      "description": "The title, e.g. \"The Ashen Prophet\""
    },
    "__schema2": {
      "description": "A parts table for the villain's own name (e.g. \"Morvaine\"), put before the title",
      "$ref": "#/$defs/__schema0"
    },
    "__schema3": {
      "default": 1,
      "description": "Relative chance of being rolled for a world",
      "$ref": "#/$defs/__schema4"
    },
    "__schema4": {
      "type": "number",
      "minimum": 0
    },
    "__schema5": {
      "default": [],
      "description": "Threat ids: the villain is favoured in worlds where one holds a land",
      "$ref": "#/$defs/__schema6"
    },
    "__schema6": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "__schema7": {
      "type": "string",
      "description": "One line for the Crisis panel"
    },
    "__schema8": {
      "type": "string",
      "description": "What a notable person or a rumour says before the plan is known"
    },
    "__schema9": {
      "type": "string",
      "description": "Logged in full when the plan is learned"
    },
    "__schema10": {
      "description": "The poiTypes id of the site where the plan is learned",
      "$ref": "#/$defs/__schema0"
    },
    "__schema11": {
      "minItems": 3,
      "maxItems": 3,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema12"
      }
    },
    "__schema12": {
      "type": "object",
      "properties": {
        "id": {
          "description": "Unique within its villain",
          "$ref": "#/$defs/__schema0"
        },
        "name": {
          "type": "string",
          "description": "e.g. \"The Opened Graves\""
        },
        "goal": {
          "type": "string",
          "description": "What the villain means to do, e.g. \"wake the dead of the barrows\""
        },
        "site": {
          "description": "The poiTypes id of the act site (weight 0, category quest)",
          "$ref": "#/$defs/__schema0"
        },
        "biomes": {
          "default": [],
          "description": "Favoured terrain: the act site is placed more often in a land of these biomes",
          "$ref": "#/$defs/__schema13"
        },
        "seat": {
          "default": false,
          "description": "The act site is placed in a kingdom seat's domain (not the start's)",
          "$ref": "#/$defs/__schema14"
        },
        "clue": {
          "type": "string",
          "description": "Logged when the act's land becomes known, e.g. \"{villain}'s diggers ... {land}.\""
        },
        "thwarted": {
          "type": "string",
          "description": "Logged when the act is thwarted"
        },
        "failed": {
          "type": "string",
          "description": "Logged when the act fails, and shown on the game-over screen"
        }
      },
      "required": [
        "id",
        "name",
        "goal",
        "site",
        "clue",
        "thwarted",
        "failed"
      ]
    },
    "__schema13": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "plains",
          "forest",
          "hills",
          "mountains",
          "marsh",
          "desert",
          "jungle",
          "sea"
        ]
      }
    },
    "__schema14": {
      "type": "boolean"
    },
    "__schema15": {
      "type": "string",
      "description": "Shown when all three acts are thwarted"
    },
    "__schema16": {
      "type": "string"
    }
  }
}
