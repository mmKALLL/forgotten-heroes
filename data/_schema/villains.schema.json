{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "const": "villains"
    },
    "source": {
      "type": "string",
      "enum": [
        "original",
        "imported",
        "imported-private",
        "procedural",
        "claude"
      ]
    },
    "notes": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/__schema0"
          },
          "name": {
            "$ref": "#/$defs/__schema1"
          },
          "names": {
            "$ref": "#/$defs/__schema2"
          },
          "weight": {
            "$ref": "#/$defs/__schema3"
          },
          "threats": {
            "$ref": "#/$defs/__schema5"
          },
          "boss": {
            "$ref": "#/$defs/__schema7"
          },
          "summary": {
            "$ref": "#/$defs/__schema9"
          },
          "omen": {
            "$ref": "#/$defs/__schema10"
          },
          "plan": {
            "$ref": "#/$defs/__schema11"
          },
          "acts": {
            "$ref": "#/$defs/__schema12"
          },
          "victory": {
            "$ref": "#/$defs/__schema21"
          },
          "notes": {
            "$ref": "#/$defs/__schema22"
          }
        },
        "required": [
          "id",
          "name",
          "summary",
          "omen",
          "plan",
          "acts",
          "victory"
        ]
      }
    }
  },
  "required": [
    "kind",
    "source",
    "entries"
  ],
  "$defs": {
    "__schema0": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "__schema1": {
      "type": "string",
      "description": "The title, e.g. \"The Ashen Prophet\""
    },
    "__schema2": {
      "description": "A parts table for the villain's own name (e.g. \"Morvaine\"), put before the title",
      "$ref": "#/$defs/__schema0"
    },
    "__schema3": {
      "default": 1,
      "description": "Relative chance of being rolled for a world",
      "$ref": "#/$defs/__schema4"
    },
    "__schema4": {
      "type": "number",
      "minimum": 0
    },
    "__schema5": {
      "default": [],
      "description": "Threat ids: the villain is favoured in worlds where one holds a land",
      "$ref": "#/$defs/__schema6"
    },
    "__schema6": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "__schema7": {
      "default": "finale",
      "description": "recurring: the villain is met at every key site, stronger each time; finale: its lieutenants hold acts I and II, and it is met at act III",
      "$ref": "#/$defs/__schema8"
    },
    "__schema8": {
      "type": "string",
      "enum": [
        "recurring",
        "finale"
      ]
    },
    "__schema9": {
      "type": "string",
      "description": "One line for the Crisis panel"
    },
    "__schema10": {
      "type": "string",
      "description": "What a notable person or a rumour says before the plan is known"
    },
    "__schema11": {
      "type": "string",
      "description": "Logged in full when the plan is learned (at act I's lead site)"
    },
    "__schema12": {
      "minItems": 3,
      "maxItems": 3,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema13"
      }
    },
    "__schema13": {
      "type": "object",
      "properties": {
        "id": {
          "description": "Unique within its villain",
          "$ref": "#/$defs/__schema0"
        },
        "name": {
          "type": "string",
          "description": "e.g. \"The Opened Graves\""
        },
        "goal": {
          "type": "string",
          "description": "What the villain means to do, e.g. \"wake the dead of the barrows\""
        },
        "lead": {
          "description": "The poiTypes id of the act's lead site (weight 0, category quest): henchmen, and the way to the key site. Act I's is where the plan is learned. Acts may share a lead type",
          "$ref": "#/$defs/__schema0"
        },
        "site": {
          "description": "The poiTypes id of the act's key site (weight 0, category quest)",
          "$ref": "#/$defs/__schema0"
        },
        "leadCr": {
          "description": "The challenge rating of the lead site's encounter (its DCs, rules/challenge)",
          "$ref": "#/$defs/__schema14"
        },
        "keyCr": {
          "description": "The challenge rating of the key site's encounter",
          "$ref": "#/$defs/__schema14"
        },
        "boss": {
          "description": "Who is met at the key site, e.g. \"Captain Hask, the Prophet's Hand\": a finale villain's lieutenant; absent for the villain itself",
          "$ref": "#/$defs/__schema15"
        },
        "surge": {
          "default": false,
          "description": "The world's danger surges in the last days before the act's due day",
          "$ref": "#/$defs/__schema16"
        },
        "biomes": {
          "default": [],
          "description": "Favoured terrain: the key site is placed more often in a land of these biomes",
          "$ref": "#/$defs/__schema17"
        },
        "seat": {
          "default": false,
          "description": "The key site is placed in a kingdom seat's domain (not the start's)",
          "$ref": "#/$defs/__schema18"
        },
        "clue": {
          "type": "string",
          "description": "Logged when the act's land (its lead's) becomes known, e.g. \"{villain}'s diggers ... {land}.\""
        },
        "open": {
          "description": "Logged on the day the act opens (else a default line)",
          "$ref": "#/$defs/__schema19"
        },
        "hurry": {
          "description": "Logged on its hurry day (else a default line)",
          "$ref": "#/$defs/__schema20"
        },
        "thwarted": {
          "type": "string",
          "description": "Logged when the act is thwarted"
        },
        "failed": {
          "type": "string",
          "description": "Logged when the act fails, and shown on the game-over screen"
        }
      },
      "required": [
        "id",
        "name",
        "goal",
        "lead",
        "site",
        "leadCr",
        "keyCr",
        "clue",
        "thwarted",
        "failed"
      ]
    },
    "__schema14": {
      "type": "number",
      "minimum": 0,
      "maximum": 30
    },
    "__schema15": {
      "type": "string"
    },
    "__schema16": {
      "type": "boolean"
    },
    "__schema17": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "plains",
          "forest",
          "hills",
          "mountains",
          "marsh",
          "desert",
          "jungle",
          "sea"
        ]
      }
    },
    "__schema18": {
      "type": "boolean"
    },
    "__schema19": {
      "type": "string"
    },
    "__schema20": {
      "type": "string"
    },
    "__schema21": {
      "type": "string",
      "description": "Shown when all three acts are thwarted"
    },
    "__schema22": {
      "type": "string"
    }
  }
}
