{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "const": "upgrades"
    },
    "source": {
      "type": "string",
      "enum": [
        "original",
        "imported",
        "imported-private",
        "procedural",
        "claude"
      ]
    },
    "notes": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "camp-kit",
              "smugglers-compartment",
              "surveyors-maps",
              "delving-gear",
              "company-banner",
              "scouts-kit"
            ]
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "description": "What it is, in a sentence of flavour (the tooltip adds what each level does)"
          },
          "basePrice": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "description": "gp: level n costs basePrice × n (a normal base is 100; the company banner 200)"
          },
          "soldBy": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema0"
            },
            "description": "Services (data/original/services.json ids) that sell its next level"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "basePrice",
          "soldBy"
        ]
      }
    }
  },
  "required": [
    "kind",
    "source",
    "entries"
  ],
  "$defs": {
    "__schema0": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    }
  }
}
